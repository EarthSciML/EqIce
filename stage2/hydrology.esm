     "description": "thickness of the transportable subglacial water layer (bwat)"
    },
    "Wtill": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "i",
      "j"
     ],
     "description": "effective thickness of the subglacial water stored in till (tillwat)",
     "default": 0.0
    },
    "flux_u": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "i",
      "j"
     ],
     "description": "time-averaged (over the update step) advective subglacial water flux, x-component (uwater_flux)",
     "default": 0.0
    },
    "flux_v": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "i",
      "j"
     ],
     "description": "time-averaged (over the update step) advective subglacial water flux, y-component (vwater_flux)",
     "default": 0.0
    },
    "P_over": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "overburden pressure rho_ice*g*H"
    },
    "R": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "reduced hydraulic potential R = P_over + rho_w*g*b (b = ice bottom surface) whose gradient drives the Shreve advection"
    },
    "grounded": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "i",
      "j"
     ],
     "description": "1 where the cell is grounded ice, 0 otherwise: grounded = H > geometry.ice_free_thickness_standard (0.01 m default; the C++ mask is ice_free = thickness <= standard, Mask.hh GeometryCalculator::compute), so exactly the mask.grounded_ice flag of the instrumented run (517 grounded cells of 961); out-of-domain reads resolve to 0 (the zero ghost), matching the C++ grounded-ice mask logic at the domain boundary"
    },
    "Wstag": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "i",
      "j",
      "o"
     ],
     "description": "edge-centered (staggered) water thickness, mask-averaged (o = 1 east edge, o = 2 north edge)"
    },
    "Kstag": {
     "type": "unknown",
     "units": "m^3 s kg^-1",
     "shape": [
      "i",
      "j",
      "o"
     ],
     "description": "edge-centered nonlinear conductivity K = k W^(alpha-1) (Pi + eps^2)^((beta-2)/2), units m^(2 beta - alpha) s^(2 beta - 3) kg^(1 - beta) = m^(7/4) kg^(-1/2) at the run's alpha = 1.25, beta = 1.5"
    },
    "Vstag": {
     "type": "unknown",
     "units": "m/s",
     "shape": [
      "i",
      "j",
      "o"
     ],
     "description": "edge-centered water velocity V = -K grad R (zero where Wstag = 0)"
    },
    "Qstag": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "i",
      "j",
      "o"
     ],
     "description": "edge-centered advective flux V*W_upwind (first-order upwinding)"
    },
    "r_till": {
     "type": "unknown",
     "units": "m/s",
     "shape": [
      "i",
      "j"
     ],
     "description": "projected till-storage rate clip(surface + basal - C, 0, tillwat_max) in the continuous limit of the per-substep clip"
    },
    "flow_W": {
     "type": "unknown",
     "units": "m/s",
     "shape": [
      "i",
      "j"
     ],
     "description": "water-thickness flow rate -div Q + div(D grad W) with D = rho_w g K Wstag"
    },
    "K_law": {
     "type": "unknown",
     "units": "m^3 s kg^-1",
     "shape": [
      "law"
     ],
     "description": "pointwise flux-law conductivity K(W,G) = k W^(alpha-1) (G^2 + eps^2)^((beta-2)/2)"
    },
    "qmag_law": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "law"
     ],
     "description": "pointwise advective flux magnitude |q| = K W G"
    }
   },
