{
 "esm": "1.1.0",
 "metadata": {
  "name": "hydrology",
  "description": "PISM subglacial-hydrology component (stage 2 of the eqice project): the Routing (Shreve) model q = -K grad psi, psi = P_over + rho_w g (b + W), of hydrology::Routing on the 31 x 31 test-F geometry, as a continuous PDE integrated by the harness over one dt = 0.25 yr update step: the till-storage equation dWtill/dt = clip(surface + basal - C, 0, tillwat_max) (projected rate), the transportable-water equation dW/dt = surface + basal - dWtill/dt - div(V W) + div(D grad W) with the edge velocity V = -K grad R, R = P_over + rho_w g b, the nonlinear conductivity K = k W^(alpha-1) (Pi + eps^2)^((beta-2)/2) (eps = 1 for beta < 2), first-order-upwind advective edge flux Q = V W_upwind, the edge diffusion D = rho_w g K Wstag, and the time-averaged regular-grid advective flux flux_u/flux_v = (1/dt) integral Q dt mapped staggered-to-regular with the grounded-ice mask. All shared math is imported by reference from ./hydrology_templates.esm. The forcing (constant surface input 0.2 m/yr, dome-centered basal melt blob 0.1 m/yr exp(-(r/200km)^2), sliding speed ignored by Routing), geometry, and initial state (W_till = 0, W = 0.5 m exp(-(r/150km)^2)) are prescribed as in the instrumented PISM v2.3.2 run of stage1/runs/hydrology.json. The initial state is declared as unknown defaults (the exact dumped W field and zero W_till/flux): the native compiler's build-time initial-condition scope cannot evaluate the observed definitions that read the state (they must be overlay-able parameter/const gathers; see the ssa.esm comments), so the component carries no ic equations and the t = 0 field values are the defaults (esm-spec 6.3). Tests pin the initial state exactly, the pointwise flux law to 1e-12, the staggered operators (Wstag/Kstag/Vstag/Qstag) pointwise at the initial state, the one-step evolution (W_out, W_till_out, overburden, flux) at selected cells, and the central anti-symmetry of the flux field. The C++ integrates the same equations with 19 explicit internal substeps capped by the CFL limit; the harness integrates the continuous ODE, so the one-step agreement reflects the documented Euler-vs-ODE scheme gap (see the test descriptions). Distributed/NullTransport/SteadyState and the effective-pressure coupling to basal strength are deferred to stage 3."
 },
 "solver": {
  "stiffness": "high",
  "reltol": 1e-08,
  "abstol": 1e-10
 },
 "index_sets": {
  "i": {
   "kind": "interval",
   "size": 31
  },
  "j": {
   "kind": "interval",
   "size": 31
  },
  "o": {
   "kind": "interval",
   "size": 2
  },
  "law": {
   "kind": "interval",
   "size": 99
  }
 },
 "models": {
  "Hydrology": {
   "expression_template_imports": [
    {
     "ref": "./hydrology_templates.esm"
    }
   ],
   "variables": {
    "dx": {
     "type": "parameter",
     "units": "m",
     "default": 58064.51612903226,
     "description": "grid spacing of the instrumented run (2*Lx/Mx = 2*900000/31 m, grid.dx)"
    },
    "dy": {
     "type": "parameter",
     "units": "m",
     "default": 58064.51612903226,
     "description": "grid spacing of the instrumented run (2*Lx/Mx = 2*900000/31 m, grid.dx)"
    },
    "dt_total": {
     "type": "parameter",
     "units": "s",
     "default": 7889231.493675,
     "description": "length of the instrumented update step (0.25 yr x 31556925.9747 s/yr, the udunits year of the run: dt_years 0.25)"
    },
    "rho_ice": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 910.0,
     "description": "ice density (constants.ice.density)"
    },
    "rho_water": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 1000.0,
     "description": "fresh-water density (constants.fresh_water.density)"
    },
    "g": {
     "type": "parameter",
     "units": "m/s^2",
     "default": 9.81,
     "description": "standard gravity (constants.standard_gravity)"
    },
    "k_cond": {
     "type": "parameter",
     "units": "m^(7/4) kg^(-1/2)",
     "default": 0.001,
     "description": "hydrology.hydraulic_conductivity = 0.001 m^{2 beta - alpha} s^{2 beta - 3} kg^{1 - beta} at alpha = 1.25, beta = 1.5"
    },
    "alpha": {
     "type": "parameter",
     "units": "1",
     "default": 1.25,
     "description": "hydrology.thickness_power_in_flux"
    },
    "beta": {
     "type": "parameter",
     "units": "1",
     "default": 1.5,
     "description": "hydrology.gradient_power_in_flux"
    },
    "C_decay": {
     "type": "parameter",
     "units": "m/s",
     "default": 3.168876464081636e-11,
     "description": "hydrology.tillwat_decay_rate = 1 mm/yr converted with the udunits year 31556925.9747 s (determined from the dumped W_till_out at the dome cell)"
    },
    "tillwat_max": {
     "type": "parameter",
     "units": "m",
     "default": 2.0,
     "description": "hydrology.tillwat_max (inactive in this run: the till reaches at most 0.0725 m)"
    },
    "bed": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "ice bottom surface elevation b = ice_bottom_surface (bed 0 everywhere in the test-F flat-bed geometry; grounded, so b = bed)"
    },
    "W0": {
     "type": "parameter",
     "units": "m",
     "default": 0.5,
     "description": "peak of the initial transportable-water blob"
    },
    "r0_W": {
     "type": "parameter",
     "units": "m",
     "default": 150000.0,
     "description": "e-folding radius of the initial W blob"
    },
