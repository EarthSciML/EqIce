     "description": "Total limited flux through the EAST face of each cell (the C++ flux_staggered(i,j,0)): the mask-limited diffusive flux plus the mask-limited first-order-upwind advective flux with the iciness-weighted face velocity. The east face of the last column (i = NX) is the domain boundary and is zero (the mask limiter zeroes every flux on the ice-free outer ring)."
    },
    "Qy": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "x",
      "y"
     ],
     "description": "Total limited flux through the NORTH face of each cell (the C++ flux_staggered(i,j,1)); the north face of the last row (j = NY) is the domain boundary and is zero."
    },
    "dH_flow": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Thickness change due to flow H(t) - H_in (the C++ thickness_change due to flow; the dumped dH_flow column)."
