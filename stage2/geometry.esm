     "description": "Ice-thickness Dirichlet B.C. mask (0 everywhere in the test run: no B.C. cells; the C++ skips cells with bc_mask > 0.5, keeping their thickness fixed)."
    },
    "rho_ice": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 910.0,
     "description": "Ice density (constants.ice.density); converts the SMB rate from kg m^-2 s^-1 to m/s."
    },
    "rho_water": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 1028.0,
     "description": "Sea-water density (constants.sea_water.density)."
    },
    "dt": {
     "type": "parameter",
     "units": "s",
     "default": 31556925.9747,
     "description": "Time step length of the instrumented run (1 year; the C++ source_term_step argument; the model is the algebraic one-step map of the C++ and does not integrate)."
    },
    "bed": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "Bed elevation (the flat test-F bed)."
    },
    "sea_level": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "Sea level elevation of the test-F run."
    },
    "ice_free_thickness_standard": {
     "type": "parameter",
     "units": "m",
     "default": 0.01,
     "description": "Ice-free thickness threshold (geometry.ice_free_thickness_standard)."
    },
    "alpha": {
     "type": "unknown",
     "units": "1",
     "description": "Flotation coefficient rho_ice/rho_water (util/Mask.hh m_alpha)."
    },
    "dH_SMB": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Effective thickness change due to the surface mass balance (the C++ effective_SMB, the dumped dH_SMB field): effective_change(H_in_src, dt*smb_rate/rho_ice), zero at B.C. and ice-free-ocean cells (none here)."
    },
    "dH_BMB": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Effective thickness change due to the basal mass balance (the C++ effective_BMB): effective_change(H_in_src + dH_SMB, -dt*basal_melt_rate), applied AFTER the SMB change and clamped against the remaining thickness -- the C++ order that preserves non-negativity (geometry.update.use_basal_melt_rate = yes). At the ice-free cells (H = 0) the clamp returns exactly 0 instead of -dt*bmr: the truncated melt of the trace."
    },
    "dH_source": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Total thickness change due to the mass-balance sources dH_SMB + dH_BMB (the dumped dH_source column)."
    },
    "H_out_source": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Ice thickness after the step H_in_src + dH_SMB + dH_BMB, applied in the C++ order (H_in_src + dH_SMB) + dH_BMB (the dumped H_out_source column)."
    },
    "surface_out": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Ice surface elevation after the step (the dumped surface_out_source column; here surface = H)."
    },
    "mask_out": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x",
      "y"
     ],
     "description": "Cell-type mask after the step (the dumped mask_out_source column; no mask changes in the one-year trace)."
    }
   },
   "equations": [
    {
     "_comment": "Flotation coefficient alpha = rho_ice/rho_water.",
     "lhs": "alpha",
     "rhs": {
      "op": "/",
      "args": [
       "rho_ice",
       "rho_water"
      ]
     }
    },
    {
     "_comment": "Effective SMB change (GeometryEvolution::compute_surface_and_basal_mass_balance): skipped at thickness-B.C. and ice-free-ocean cells; otherwise effective_change(H, dt*smb/rho_ice) -- the clamped step change that cannot drive the thickness negative.",
     "lhs": "dH_SMB",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i",
       "j"
      ],
      "args": [],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       }
      },
      "expr": {
       "op": "ifelse",
       "args": [
        {
         "op": "or",
         "args": [
          {
           "op": ">",
           "args": [
            {
             "op": "index",
             "args": [
              "bc_mask",
              "i",
              "j"
             ]
            },
            0.5
           ]
          },
          {
           "op": "==",
           "args": [
            {
             "op": "index",
             "args": [
              "mask_in_src",
              "i",
              "j"
             ]
            },
            4.0
           ]
          }
         ]
        },
        0.0,
        {
         "op": "pism_effective_change",
         "args": [
          {
           "op": "index",
           "args": [
            "H_in_src",
            "i",
            "j"
           ]
          },
          {
           "op": "/",
           "args": [
            {
             "op": "*",
             "args": [
              "dt",
              {
               "op": "index",
               "args": [
                "smb_rate",
                "i",
                "j"
               ]
              }
             ]
            },
            "rho_ice"
           ]
          }
         ]
        }
       ]
      }
     }
    },
    {
     "_comment": "Effective BMB change: skipped at B.C. and ice-free-ocean cells; otherwise effective_change(H + dH_SMB, -dt*bmr) -- the basal melt clamped against the thickness remaining after the SMB change (the C++ applies SMB first, then BMB, in the order that preserves non-negativity).",
     "lhs": "dH_BMB",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i",
       "j"
      ],
      "args": [],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       }
      },
      "expr": {
       "op": "ifelse",
       "args": [
        {
         "op": "or",
         "args": [
          {
           "op": ">",
           "args": [
            {
             "op": "index",
             "args": [
              "bc_mask",
              "i",
              "j"
             ]
            },
            0.5
           ]
          },
          {
           "op": "==",
           "args": [
            {
             "op": "index",
             "args": [
              "mask_in_src",
              "i",
              "j"
             ]
            },
            4.0
           ]
          }
         ]
        },
        0.0,
        {
         "op": "pism_effective_change",
         "args": [
          {
           "op": "+",
           "args": [
            {
             "op": "index",
             "args": [
              "H_in_src",
              "i",
              "j"
             ]
            },
            {
             "op": "index",
             "args": [
              "dH_SMB",
              "i",
              "j"
             ]
            }
           ]
          },
          {
           "op": "-",
           "args": [
            {
             "op": "*",
             "args": [
              "dt",
              {
               "op": "index",
               "args": [
                "basal_melt_rate",
                "i",
                "j"
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     }
    },
    {
     "_comment": "Total source thickness change (array-level elementwise form).",
     "lhs": "dH_source",
     "rhs": {
      "op": "+",
      "args": [
       "dH_SMB",
       "dH_BMB"
      ]
     }
    },
    {
     "_comment": "Thickness after the step, applied in the C++ order (H_in_src + dH_SMB) + dH_BMB (array-level elementwise form; GeometryEvolution::apply_mass_fluxes).",
     "lhs": "H_out_source",
     "rhs": {
      "op": "+",
      "args": [
       "H_in_src",
       "dH_source"
      ]
     }
    },
    {
     "_comment": "Surface elevation after the step from the updated thickness (util/Mask.hh; here surface = H).",
     "lhs": "surface_out",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i",
       "j"
      ],
      "args": [],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       }
      },
      "expr": {
       "op": "pism_cell_surface",
       "args": [
        "sea_level",
        "bed",
        {
         "op": "index",
         "args": [
          "H_out_source",
          "i",
          "j"
         ]
        },
        "alpha"
       ]
      }
     }
    },
    {
     "_comment": "Mask after the step from the updated thickness (util/Mask.hh).",
     "lhs": "mask_out",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i",
       "j"
      ],
      "args": [],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       }
      },
      "expr": {
       "op": "pism_cell_mask",
       "args": [
        "sea_level",
        "bed",
        {
         "op": "index",
         "args": [
          "H_out_source",
          "i",
          "j"
         ]
        },
        "alpha",
        "ice_free_thickness_standard"
       ]
      }
     }
    }
