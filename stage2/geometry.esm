   "variables": {
    "mask_c": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "Center-cell mask of the sample."
    },
    "mask_n": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "North-neighbor mask of the sample."
    },
    "mask_e": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "East-neighbor mask of the sample."
    },
    "mask_s": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "South-neighbor mask of the sample."
    },
    "mask_w": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "West-neighbor mask of the sample."
    },
    "H_c": {
     "type": "parameter",
     "units": "m",
     "default": 1000.0,
     "description": "Center-cell thickness of the sample (0 at ice-free star points)."
    },
    "H_n": {
     "type": "parameter",
     "units": "m",
     "default": 1000.0,
     "description": "North-neighbor thickness of the sample."
    },
    "H_e": {
     "type": "parameter",
     "units": "m",
     "default": 1000.0,
     "description": "East-neighbor thickness of the sample."
    },
    "H_s": {
     "type": "parameter",
     "units": "m",
     "default": 1000.0,
     "description": "South-neighbor thickness of the sample."
    },
    "H_w": {
     "type": "parameter",
     "units": "m",
     "default": 1000.0,
     "description": "West-neighbor thickness of the sample."
    },
    "h_c": {
     "type": "parameter",
     "units": "m",
     "default": 500.0,
     "description": "Center-cell surface elevation of the sample (0 at ice-free star points)."
    },
    "h_n": {
     "type": "parameter",
     "units": "m",
     "default": 500.0,
     "description": "North-neighbor surface elevation of the sample."
    },
    "h_e": {
     "type": "parameter",
     "units": "m",
     "default": 500.0,
     "description": "East-neighbor surface elevation of the sample."
    },
    "h_s": {
     "type": "parameter",
     "units": "m",
     "default": 500.0,
     "description": "South-neighbor surface elevation of the sample."
    },
    "h_w": {
     "type": "parameter",
     "units": "m",
     "default": 500.0,
     "description": "West-neighbor surface elevation of the sample."
    },
    "bed": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "Bed elevation of the sample cell."
    },
    "threshold": {
     "type": "unknown",
     "units": "m",
     "description": "part_grid_threshold_thickness(mask star, thickness star, surface star, bed) = max(min(h_avg - bed, H_avg), 0) with H_avg/h_avg the averages over the icy N/S/E/W neighbors (0 with no icy neighbors), the closed form of geometry/part_grid_threshold_thickness.cc."
    }
   },
