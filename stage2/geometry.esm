     "type": "unknown",
     "units": "m",
     "shape": [
      "x",
      "y"
     ],
     "description": "Ice surface elevation after the step (the dumped surface_out_flow column), computed from the updated thickness with the util/Mask.hh rule (bed 0 and sea level 0 keep every cell grounded, so surface = H)."
    },
    "mask_out": {
     "type": "unknown",
     "units": "1",
