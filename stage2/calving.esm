    "CalvingAtThickness": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "mask_in": {
          "type": "parameter",
          "units": "1",
          "default": 3,
          "description": "cell-type mask before calving (PISM 2.3.2 MaskValue: 0 ice-free bedrock, 2 grounded ice, 3 floating ice, 4 ice-free ocean)"
        },
        "H_in": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "ice thickness before calving (geometry.ice_thickness)"
        },
        "threshold": {
          "type": "parameter",
          "units": "m",
          "default": 300.0,
          "description": "terminal thickness threshold (calving.thickness_calving.threshold = 300 m in the run; the thickness_calving_threshold forcing field is the constant value here)"
        },
        "next_to_ice_free_ocean": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to ice-free ocean (the stencil property mask::next_to_ice_free_ocean, supplied by the geometry coupling)"
        },
        "mask_out": {
          "type": "unknown",
          "units": "1",
          "description": "cell-type mask after calving: 4 (ice-free ocean) for a calved cell, unchanged otherwise"
        },
        "H_out": {
          "type": "unknown",
          "units": "m",
          "description": "ice thickness after calving: 0 for a calved cell, unchanged otherwise"
        },
        "removed": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the cell was calved (mask changed), 0 otherwise (the dump's removed column)"
        }
      },
      "equations": [
        {
          "_comment": "CalvingAtThickness::update: cells that are floating AND next to ice-free ocean AND thinner than the threshold are removed in place (thickness = 0, mask = MASK_ICE_FREE_OCEAN = 4).",
          "lhs": "H_out",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask_in",
                      3
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "next_to_ice_free_ocean",
                          1
                        ]
                      },
                      {
                        "op": "<",
                        "args": [
                          "H_in",
                          "threshold"
                        ]
                      }
                    ]
                  }
                ]
              },
              0.0,
              "H_in"
            ]
          }
        },
        {
          "lhs": "mask_out",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask_in",
                      3
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "next_to_ice_free_ocean",
                          1
                        ]
                      },
                      {
                        "op": "<",
                        "args": [
                          "H_in",
                          "threshold"
                        ]
                      }
                    ]
                  }
                ]
              },
              4,
              "mask_in"
            ]
          }
        },
        {
          "lhs": "removed",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask_in",
                      3
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "next_to_ice_free_ocean",
                          1
                        ]
                      },
                      {
                        "op": "<",
                        "args": [
                          "H_in",
                          "threshold"
                        ]
                      }
                    ]
                  }
                ]
              },
              1,
              0
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "front_cell_removed",
          "description": "The calving-front floating cell (i=59, j=32, H = 188.7737745520679 m < 300 m, next to the ice-free ocean at i=60) is removed in place: thickness = 0, mask = 4 (stage1/dumps/calving/calving_at_thickness.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask_in": 3,
            "H_in": 188.7737745520679,
            "threshold": 300.0,
            "next_to_ice_free_ocean": 1
          },
          "assertions": [
            {
              "variable": "H_out",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "mask_out",
              "time": 0.0,
              "expected": 4,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "removed",
              "time": 0.0,
              "expected": 1,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "interior_floating_not_removed",
          "description": "An interior floating cell (i=58, j=32, H = 189.574 m) is not next to ice-free ocean, so it is not removed even though H < threshold (the dump removes exactly the 65 cells of the front column i=59).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask_in": 3,
            "H_in": 189.57423986201835,
            "threshold": 300.0,
            "next_to_ice_free_ocean": 0
          },
          "assertions": [
            {
              "variable": "H_out",
              "time": 0.0,
              "expected": 189.57423986201835,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "mask_out",
              "time": 0.0,
              "expected": 3,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "removed",
              "time": 0.0,
              "expected": 0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "thick_floating_front_not_removed_synthetic",
          "description": "A floating front cell with H = 400 m >= threshold = 300 m is not removed (the H < threshold condition; synthetic tuple, the dump front is thinner than the threshold).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask_in": 3,
            "H_in": 400.0,
            "threshold": 300.0,
            "next_to_ice_free_ocean": 1
          },
          "assertions": [
            {
              "variable": "H_out",
              "time": 0.0,
              "expected": 400.0,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "mask_out",
              "time": 0.0,
              "expected": 3,
