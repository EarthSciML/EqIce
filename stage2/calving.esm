    "FrontalMeltUndercutting": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "h": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "water depth at the front h"
        },
        "q_sg": {
          "type": "parameter",
          "units": "m/day",
          "default": 0.0,
          "description": "subglacial water flux q_sg, m/day"
        },
        "TF": {
          "type": "parameter",
          "units": "K",
          "default": 0.0,
          "description": "thermal forcing TF, Celsius (the empirical kernel treats the C value; declared in K for dimensional bookkeeping)"
        },
        "A": {
          "type": "parameter",
          "units": "1",
          "default": 0.0003,
          "description": "tuning parameter A (frontal_melt.routing.parameter_a = 3e-4)"
        },
        "B": {
          "type": "parameter",
          "units": "1",
          "default": 0.15,
          "description": "tuning parameter B (frontal_melt.routing.parameter_b = 0.15)"
        },
        "alpha": {
          "type": "parameter",
          "units": "1",
          "default": 0.39,
          "description": "exponent alpha (frontal_melt.routing.power_alpha = 0.39)"
        },
        "beta": {
          "type": "parameter",
          "units": "1",
          "default": 1.18,
          "description": "exponent beta (frontal_melt.routing.power_beta = 1.18)"
        },
        "q_m_m_day": {
          "type": "unknown",
          "units": "m/day",
          "description": "frontal melt rate q_m = (A*h*q_sg^alpha + B)*TF^beta, m/day (the dump's q_m_m_day column)"
        }
      },
      "equations": [
        {
          "_comment": "FrontalMeltPhysics::frontal_melt_from_undercutting (Rignot et al. 2016 equation 1) with the nonnegativity clamps: 0 for h <= 0 or q_sg < 0 or TF < 0.",
          "lhs": "q_m_m_day",
          "rhs": {
            "op": "frontal_melt_undercutting",
            "args": [
              "h",
              "q_sg",
              "TF"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "row_000",
          "description": "Kernel row 0: h = 0.0 m, q_sg = -0.1 m/day, TF = -1.0 C. q_m = (A*h*q_sg^alpha + B)*TF^beta with the nonnegativity clamps (0 for h <= 0 or q_sg < 0 or TF < 0) = 0.0 m/day (stage1/dumps/calving/frontal_melt_undercutting.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "h": 0.0,
            "q_sg": -0.1,
            "TF": -1.0
          },
          "assertions": [
            {
              "variable": "q_m_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "row_001",
          "description": "Kernel row 1: h = 0.0 m, q_sg = -0.1 m/day, TF = 0.0 C. q_m = (A*h*q_sg^alpha + B)*TF^beta with the nonnegativity clamps (0 for h <= 0 or q_sg < 0 or TF < 0) = 0.0 m/day (stage1/dumps/calving/frontal_melt_undercutting.csv).",
