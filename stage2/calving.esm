    "FrontalMeltISMIP6": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "h": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "water depth at the front h"
        },
        "q_sg": {
          "type": "parameter",
          "units": "m/day",
          "default": 0.0,
          "description": "subglacial water flux q_sg, m/day"
        },
        "TF": {
          "type": "parameter",
          "units": "K",
          "default": 0.0,
          "description": "thermal forcing TF, Celsius (declared in K for dimensional bookkeeping)"
        },
        "A": {
          "type": "parameter",
          "units": "1",
          "default": 0.0003,
          "description": "tuning parameter A (frontal_melt.routing.parameter_a = 3e-4)"
        },
        "B": {
          "type": "parameter",
          "units": "1",
          "default": 0.15,
          "description": "tuning parameter B (frontal_melt.routing.parameter_b = 0.15)"
        },
        "alpha": {
          "type": "parameter",
          "units": "1",
          "default": 0.39,
          "description": "exponent alpha (frontal_melt.routing.power_alpha = 0.39)"
        },
        "beta": {
          "type": "parameter",
          "units": "1",
          "default": 1.18,
          "description": "exponent beta (frontal_melt.routing.power_beta = 1.18)"
        },
        "q_m_m_day": {
          "type": "unknown",
          "units": "m/day",
          "description": "frontal melt rate q_m = (A*h*q_sg^alpha + B)*TF^beta, m/day (the dump's q_m_m_day column)"
        }
      },
      "equations": [
        {
