    "EigenCalving": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "mask": {
          "type": "parameter",
          "units": "1",
          "default": 4,
          "description": "cell-type mask (PISM 2.3.2 MaskValue: 0 ice-free bedrock, 2 grounded ice, 3 floating ice, 4 ice-free ocean)"
        },
        "next_to_floating_ice": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to floating ice (the stencil property mask::next_to_floating_ice, supplied by the geometry coupling)"
        },
        "eigen1_avg": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "mean of the largest principal strain rates over icy, non-margin cells at +-2 cells from the front (the EigenCalving::update front sampling average; the sampling itself is part of the deferred subassembly coupling)"
        },
        "eigen2_avg": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "mean of the smallest principal strain rates over the same sampled cells"
        },
        "K_eigen": {
          "type": "parameter",
          "units": "m s",
          "default": 3e+16,
          "description": "eigen-calving constant (calving.eigen_calving.K = 3e16 m s in the run; the config default is 0)"
        },
        "seconds_per_year": {
          "type": "parameter",
          "units": "s/yr",
          "default": 31556925.9747,
          "description": "PISM/udunits tropical year 3.15569259747e7 s per yr (365.242198781 days; recovered from the stage-1 dump rate_m_yr/rate_m_s ratio); the s/yr units make rate*seconds_per_year dimensionally m/yr"
        },
        "rate": {
          "type": "unknown",
          "units": "m/s",
          "description": "horizontal calving rate due to eigen-calving (eigen_calving_rate; m s^-1)"
        },
        "rate_m_yr": {
          "type": "unknown",
          "units": "m/yr",
          "description": "calving rate in m/year (the dump's rate_m_yr column)"
        }
      },
      "equations": [
        {
          "_comment": "EigenCalving::update: the rate is nonzero only at ice-free-ocean cells next to floating ice (the calving front); there rate = K * eigen1_avg * (eigen2_avg - 0) when eigen2_avg > 0 and eigen1_avg > 0 (extensive flow), else 0 (compressive branch; eigenCalvOffset = 0).",
          "lhs": "rate",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask",
                      4
                    ]
                  },
                  {
                    "op": "==",
                    "args": [
                      "next_to_floating_ice",
                      1
                    ]
                  }
                ]
              },
              {
                "op": "eigen_calving_rate",
                "args": [
                  "eigen1_avg",
                  "eigen2_avg",
                  "K_eigen"
                ]
              },
              0.0
            ]
          }
        },
        {
          "_comment": "Output conversion to m/year with the udunits tropical year (the dump's rate_m_yr column).",
          "lhs": "rate_m_yr",
          "rhs": {
            "op": "*",
            "args": [
              "rate",
              "seconds_per_year"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "front_compressive_branch_exact_run",
          "description": "Exact-velocity run front cell (i=60, j=32): eigen2_avg = -1.7771458472818954e-26 < 0, so the rate is zero (compressive branch) even though the cell is at the calving front (stage1/dumps/calving/eigen_calving.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 4,
            "next_to_floating_ice": 1,
            "eigen1_avg": 1.6667188365752898e-11,
            "eigen2_avg": -1.7771458472818954e-26
          },
          "assertions": [
            {
              "variable": "rate",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "rate_m_yr",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "interior_cell_never_calves",
