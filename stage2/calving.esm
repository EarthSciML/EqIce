              }
            }
          ]
        }
      ]
    },
    "HayhurstCalving": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "mask": {
          "type": "parameter",
          "units": "1",
          "default": 3,
          "description": "cell-type mask (PISM 2.3.2 MaskValue: 0 ice-free bedrock, 2 grounded ice, 3 floating ice, 4 ice-free ocean); the rate is computed at icy cells (2 or 3)"
        },
        "H": {
          "type": "parameter",
          "units": "m",
          "default": 600.0,
          "description": "ice thickness (geometry.ice_thickness)"
        },
        "water_depth": {
          "type": "parameter",
          "units": "m",
          "default": 1000.0,
          "description": "water depth sea_level - bed (geometry.sea_level_elevation - geometry.bed_elevation)"
        },
        "rho_i": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_w": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1028.0,
          "description": "sea water density (constants.sea_water.density)"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "standard gravity (constants.standard_gravity)"
        },
        "B_tilde": {
          "type": "parameter",
          "units": "1",
          "default": 65.0,
          "description": "effective damage rate B_tilde = 65 (MPa)^0.43 / year (calving.hayhurst_calving.B_tilde); the (MPa)^r -> Pa^r conversion (1e-6)^r and the year -> second conversion are folded into hayhurst_unit_scaling"
        },
        "exponent_r": {
          "type": "parameter",
          "units": "1",
          "default": 0.43,
          "description": "damage-law exponent r (calving.hayhurst_calving.exponent_r = 0.43)"
        },
        "sigma_threshold": {
          "type": "parameter",
          "units": "Pa",
          "default": 170000.0,
          "description": "damage threshold stress (calving.hayhurst_calving.sigma_threshold = 0.17 MPa, converted to Pa)"
        },
        "seconds_per_year": {
          "type": "parameter",
          "units": "s/yr",
          "default": 31556925.9747,
          "description": "PISM/udunits tropical year 3.15569259747e7 s per yr (the s/yr units make rate*seconds_per_year dimensionally m/yr)"
        },
        "H_eff": {
          "type": "unknown",
          "units": "m",
          "description": "ice thickness with the floating-shelf adjustment H_eff = water_depth + (1 - rho_i/rho_w)*H when water_depth/H > rho_i/rho_w, else H (HayhurstCalving::update)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "flotation ratio omega = water_depth / H_eff (after the floating-shelf adjustment; the dump's omega column)"
        },
        "sigma_0": {
          "type": "unknown",
          "units": "Pa",
          "description": "maximum tensile stress approximation sigma_0 = max((0.4 - 0.45*(omega - 0.065)^2) * rho_i * g * H_eff, sigma_threshold) (Mercenier et al. 2018), with the floating-adjusted H_eff; NOTE: the stage-1 dump's sigma_0_Pa column is the instrument's reconstruction with the UNADJUSTED H and therefore differs from this component's sigma_0 whenever the floating adjustment applies (everywhere on the fully floating test shelf) -- the rate, which is asserted, is computed from this H_eff-based sigma_0"
        },
        "rate": {
          "type": "unknown",
          "units": "m/s",
          "description": "horizontal calving rate due to Hayhurst calving (hayhurst_calving_rate)"
        },
        "rate_m_yr": {
          "type": "unknown",
          "units": "m/yr",
          "description": "calving rate in m/year (the dump's rate_m_yr column)"
        }
      },
      "equations": [
        {
          "_comment": "HayhurstCalving::update floating-shelf adjustment: H_eff replaces H in sigma_0 and the rate when the front is floating.",
          "lhs": "H_eff",
          "rhs": {
            "op": "hayhurst_H_eff",
            "args": [
              "water_depth",
              "H"
            ]
          }
        },
        {
          "lhs": "omega",
          "rhs": {
            "op": "hayhurst_omega",
            "args": [
              "water_depth",
              "H"
            ]
          }
        },
        {
          "lhs": "sigma_0",
          "rhs": {
            "op": "hayhurst_sigma_0",
            "args": [
              "omega",
              "H_eff"
            ]
          }
        },
        {
          "_comment": "HayhurstCalving::update equation 22: rate = B_tilde * unit_scaling * (1 - omega^2.8) * (sigma_0 - sigma_threshold)^r * H_eff at icy cells with water_depth > 0; 0 elsewhere (the ice-free-cell neighbor-average propagation of the second loop is deferred to the subassembly coupling).",
          "lhs": "rate",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "or",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "mask",
                          2
                        ]
                      },
                      {
                        "op": "==",
                        "args": [
                          "mask",
                          3
                        ]
                      }
                    ]
                  },
                  {
                    "op": ">",
                    "args": [
                      "water_depth",
                      0.0
                    ]
                  }
                ]
              },
              {
                "op": "hayhurst_calving_rate",
                "args": [
                  "B_tilde",
                  "exponent_r",
                  "omega",
                  "sigma_0",
                  "sigma_threshold",
                  "H_eff"
                ]
              },
              0.0
            ]
          }
        },
        {
          "lhs": "rate_m_yr",
          "rhs": {
            "op": "*",
            "args": [
              "rate",
              "seconds_per_year"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "grounded_branch_synthetic",
          "description": "Grounded-ice branch (no floating adjustment): H = 500 m, water_depth = 200 m gives omega = 0.4 < rho_i/rho_w = 0.8852, so H_eff = H; sigma_0 = (0.4 - 0.45*(0.4-0.065)^2)*910*9.81*500 = 1559495.2 Pa > sigma_threshold (unclamped). Synthetic tuple exercising the non-adjusted code path (the dump shelf is fully floating).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 2,
            "H": 500.0,
            "water_depth": 200.0
          },
          "assertions": [
            {
              "variable": "omega",
              "time": 0.0,
              "expected": 0.4,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "sigma_0",
              "time": 0.0,
              "expected": 1560005.1455625002,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "rate",
              "time": 0.0,
              "expected": 0.0010953367684824506,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "clamped_sigma_zero_rate_synthetic",
          "description": "Floating shelf with a thin front (H = 100 m, water_depth = 1000 m): H_eff = 1011.4786 m, omega = 0.98865, and the raw sigma_0 = 145299 Pa < sigma_threshold, so sigma_0 is clamped to 170000 Pa and the rate is exactly 0 (sigma_0 - sigma_threshold = 0). Synthetic tuple exercising the clamp branch.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 3,
            "H": 100.0,
            "water_depth": 1000.0
          },
          "assertions": [
            {
              "variable": "omega",
