    "FloatKill": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "mask_in": {
          "type": "parameter",
          "units": "1",
          "default": 3,
          "description": "cell-type mask before calving (PISM 2.3.2 MaskValue: 0 ice-free bedrock, 2 grounded ice, 3 floating ice, 4 ice-free ocean)"
        },
        "H_in": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "ice thickness before calving (geometry.ice_thickness)"
        },
        "sea_level": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "sea level elevation (geometry.sea_level_elevation)"
        },
        "bed": {
          "type": "parameter",
          "units": "m",
          "default": -1000.0,
          "description": "bed elevation (geometry.bed_elevation)"
        },
        "rho_i": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_w": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1028.0,
          "description": "sea water density (constants.sea_water.density)"
        },
        "margin_only": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "calving.float_kill.margin_only = false in the run: when true, only floating cells next to ice-free ocean are calved"
        },
        "calve_near_grounding_line": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "calving.float_kill.calve_near_grounding_line = true in the run: when false, floating cells next to grounded ice are kept"
        },
        "next_to_ice_free_ocean": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to ice-free ocean (stencil property, supplied by the geometry coupling)"
        },
        "next_to_grounded_ice": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to grounded ice (stencil property, supplied by the geometry coupling)"
        },
        "h_f": {
          "type": "unknown",
          "units": "m",
          "description": "analytic flotation thickness h_f = (sea_level - bed) * rho_w / rho_i (the dump's h_f column)"
        },
        "floating": {
          "type": "unknown",
          "units": "1",
          "description": "1 for floating-ice cells with H > 0 (mask::floating_ice; the dump's floating column)"
        },
        "mask_out": {
          "type": "unknown",
          "units": "1",
          "description": "cell-type mask after calving: 4 (ice-free ocean) for a calved cell, unchanged otherwise"
        },
        "H_out": {
          "type": "unknown",
          "units": "m",
          "description": "ice thickness after calving: 0 for a calved cell, unchanged otherwise"
        },
        "removed": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the cell was calved, 0 otherwise (the dump's removed column)"
        }
      },
      "equations": [
        {
          "_comment": "The analytic flotation thickness h_f = (sea_level - bed) * rho_w / rho_i (the dump column; the mask::floating_ice classification of the geometry coupling uses the same criterion).",
          "lhs": "h_f",
          "rhs": {
            "op": "flotation_thickness",
            "args": [
              "sea_level",
              "bed"
            ]
          }
        },
        {
          "_comment": "mask::floating_ice with H > 0 (the dump's floating column).",
          "lhs": "floating",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask_in",
                      3
                    ]
                  },
                  {
                    "op": ">",
