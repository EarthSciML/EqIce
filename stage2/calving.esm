    "vonMisesCalving": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "mask": {
          "type": "parameter",
          "units": "1",
          "default": 4,
          "description": "cell-type mask (PISM 2.3.2 MaskValue: 0 ice-free bedrock, 2 grounded ice, 3 floating ice, 4 ice-free ocean)"
        },
        "next_to_ice": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to any ice (the stencil property mask::next_to_ice, supplied by the geometry coupling)"
        },
        "vel_avg": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "mean ice speed |v| over icy cells at +-2 cells from the front (the vonMisesCalving::update front sampling average; the sampling itself is part of the deferred subassembly coupling)"
        },
        "hardness_avg": {
          "type": "parameter",
          "units": "Pa s^(1/3)",
          "default": 190000000.0,
          "description": "mean vertically averaged flow-law hardness B over the same sampled cells (averaged_hardness with the SSA flow law; isothermal_glen B = 1.9e8 Pa s^(1/3) in the run)"
        },
        "eigen1_avg": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "mean largest principal strain rate over the same sampled cells"
        },
        "eigen2_avg": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "mean smallest principal strain rate over the same sampled cells"
        },
        "sigma_max": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000000.0,
          "description": "von Mises calving threshold (calving.vonmises_calving.sigma_max = 1e6 Pa in the run)"
        },
        "glen_n": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Glen exponent of the flow law (calving.vonmises_calving.Glen_exponent = 3 in the run; the flow_law is the SSA's isothermal_glen)"
        },
        "seconds_per_year": {
          "type": "parameter",
          "units": "s/yr",
          "default": 31556925.9747,
          "description": "PISM/udunits tropical year 3.15569259747e7 s per yr (the s/yr units make rate*seconds_per_year dimensionally m/yr)"
        },
        "e_s": {
          "type": "unknown",
          "units": "1/s",
          "description": "effective tensile strain rate e_s = sqrt(0.5*(max(0,eigen1_avg)^2 + max(0,eigen2_avg)^2)) (Morlighem et al. 2016 eq. 6)"
        },
        "sigma_tilde": {
          "type": "unknown",
          "units": "Pa",
          "description": "flow-law stress sigma_tilde = sqrt(3) * hardness_avg * e_s^(1/glen_n) (Morlighem et al. 2016 eq. 7)"
        },
        "rate": {
          "type": "unknown",
          "units": "m/s",
          "description": "horizontal calving rate due to von Mises calving (vonmises_calving_rate)"
        },
        "rate_m_yr": {
          "type": "unknown",
          "units": "m/yr",
          "description": "calving rate in m/year (the dump's rate_m_yr column)"
        }
      },
      "equations": [
        {
          "_comment": "vonMisesCalving::update equation 6: the effective tensile strain rate from the averaged principal strain rates (the compressive eigenvalue is clamped at 0).",
          "lhs": "e_s",
          "rhs": {
            "op": "vonmises_effective_tensile_strain_rate",
            "args": [
              "eigen1_avg",
              "eigen2_avg"
            ]
          }
        },
        {
          "_comment": "vonMisesCalving::update equation 7: sigma_tilde = sqrt(3) * hardness * e_s^(1/n).",
          "lhs": "sigma_tilde",
          "rhs": {
            "op": "vonmises_sigma_tilde",
            "args": [
              "hardness_avg",
              "e_s",
              "glen_n"
            ]
          }
        },
        {
          "_comment": "vonMisesCalving::update equation 4: rate = |v|_avg * sigma_tilde / sigma_max at ice-free-ocean cells next to ice (the calving front); 0 elsewhere.",
          "lhs": "rate",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask",
                      4
                    ]
                  },
                  {
                    "op": "==",
                    "args": [
                      "next_to_ice",
                      1
                    ]
                  }
                ]
              },
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "vel_avg",
                      "sigma_tilde"
                    ]
                  },
                  "sigma_max"
                ]
              },
              0.0
            ]
          }
        },
        {
          "lhs": "rate_m_yr",
          "rhs": {
            "op": "*",
            "args": [
              "rate",
              "seconds_per_year"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "interior_cell_never_calves",
          "description": "An interior floating-shelf cell (mask = 3, not next to ice) has rate = 0 even though e_s and sigma_tilde are well defined from the averaged strain rates.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 3,
            "next_to_ice": 0,
            "vel_avg": 3.0098147859559898e-05,
            "hardness_avg": 190000000.0,
            "eigen1_avg": 1.666720086386059e-11,
            "eigen2_avg": -2.908056841006738e-26
          },
          "assertions": [
            {
              "variable": "rate",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
