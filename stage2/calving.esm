    "ConstantFrontalMelt": {
      "expression_template_imports": [
        {
          "ref": "./calving_templates.esm"
        }
      ],
      "variables": {
        "mask": {
          "type": "parameter",
          "units": "1",
          "default": 4,
          "description": "cell-type mask (PISM 2.3.2 MaskValue: 0 ice-free bedrock, 2 grounded ice, 3 floating ice, 4 ice-free ocean)"
        },
        "next_to_ice": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to any ice (stencil property, supplied by the geometry coupling)"
        },
        "next_to_grounded_ice": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "1 when the cell is next to grounded ice (stencil property, supplied by the geometry coupling)"
        },
        "include_floating_ice": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "frontal_melt.include_floating_ice: 0 (no, the default) targets grounded ice only; 1 (yes) also targets floating ice and ice-free-ocean cells next to ice"
        },
        "melt_rate_config_m_day": {
          "type": "parameter",
          "units": "m/day",
          "default": 1.0,
          "description": "constant melt rate (frontal_melt.constant.melt_rate = 1 m/day in the run)"
        },
        "H_threshold": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "part-grid threshold thickness at the front cell (part_grid_threshold_thickness: the mean thickness/surface elevation over icy neighbors; the stencil itself is part of the deferred subassembly coupling, and the dump carries the resulting values)"
        },
        "sea_level": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "sea level elevation (geometry.sea_level_elevation)"
        },
        "bed": {
          "type": "parameter",
          "units": "m",
          "default": -1000.0,
          "description": "bed elevation (geometry.bed_elevation)"
        },
        "rho_i": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_w": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1028.0,
          "description": "sea water density (constants.sea_water.density)"
        },
        "seconds_per_day": {
          "type": "parameter",
          "units": "s/day",
          "default": 86400.0,
          "description": "seconds per day (the dump's melt_rate_m_day / melt_rate_m_s ratio); the s/day units make melt_rate_m_s = melt_rate_m_day/seconds_per_day dimensionally m/s and melt_rate_m_day = melt_rate_m_s*seconds_per_day dimensionally m/day"
        },
        "melt_rate_m_s": {
          "type": "unknown",
          "units": "m/s",
          "description": "frontal melt rate in m/s (frontalmelt::Constant::update_impl)"
        },
        "melt_rate_m_day": {
          "type": "unknown",
          "units": "m/day",
          "description": "frontal melt rate in m/day (the dump's melt_rate_m_day column)"
        },
        "H_submerged": {
          "type": "unknown",
          "units": "m",
          "description": "submerged front thickness: (rho_i/rho_w)*H_threshold for a floating front, max(sea_level - bed, 0) for a grounded front (FrontalMelt::compute_retreat_rate; the dump's H_submerged column)"
        },
        "retreat_rate_m_s": {
          "type": "unknown",
          "units": "m/s",
          "description": "retreat rate due to frontal melt in m/s: (H_submerged / H_threshold) * melt rate at ice-free-ocean cells next to ice, 0 elsewhere (FrontalMelt::compute_retreat_rate)"
        },
        "retreat_rate_m_day": {
          "type": "unknown",
          "units": "m/day",
          "description": "retreat rate in m/day (the dump's retreat_rate_m_day column)"
        }
      },
      "equations": [
        {
          "_comment": "frontalmelt::Constant::update_impl: melt_rate = the constant where apply() targets cells (include_floating_ice = no: grounded ice and ice-free-ocean cells next to grounded ice; = yes: all icy cells and ice-free-ocean cells next to ice), 0 elsewhere; the config melt rate (m/day) is converted to m/s.",
          "lhs": "melt_rate_m_s",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "include_floating_ice",
                      1
                    ]
                  },
                  {
                    "op": "or",
                    "args": [
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "==",
                            "args": [
                              "mask",
                              4
                            ]
                          },
                          {
                            "op": "==",
                            "args": [
                              "next_to_ice",
                              1
                            ]
                          }
                        ]
                      },
                      {
                        "op": "or",
                        "args": [
                          {
                            "op": "==",
                            "args": [
                              "mask",
                              2
                            ]
                          },
                          {
                            "op": "==",
                            "args": [
                              "mask",
                              3
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "or",
                    "args": [
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "==",
                            "args": [
                              "mask",
                              4
                            ]
                          },
                          {
                            "op": "==",
                            "args": [
                              "next_to_grounded_ice",
                              1
                            ]
                          }
                        ]
                      },
                      {
                        "op": "==",
                        "args": [
                          "mask",
                          2
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "/",
                "args": [
                  "melt_rate_config_m_day",
                  "seconds_per_day"
                ]
              },
              0.0
            ]
          }
        },
        {
          "lhs": "melt_rate_m_day",
          "rhs": {
            "op": "*",
            "args": [
              "melt_rate_m_s",
              "seconds_per_day"
            ]
          }
        },
        {
          "_comment": "FrontalMelt::compute_retreat_rate: the submerged part of the front, from the part-grid threshold thickness and the flotation criterion (GeometryCalculator mask of the hypothetical H_thickness cell).",
          "lhs": "H_submerged",
          "rhs": {
            "op": "frontal_melt_H_submerged",
            "args": [
              "H_threshold",
              "sea_level",
              "bed"
            ]
          }
        },
        {
          "_comment": "FrontalMelt::compute_retreat_rate: retreat = (H_submerged / H_threshold) * melt rate at ice-free-ocean cells next to ice; 0 elsewhere.",
          "lhs": "retreat_rate_m_s",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "mask",
                      4
                    ]
                  },
                  {
                    "op": "==",
                    "args": [
                      "next_to_ice",
                      1
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      "H_submerged",
                      "H_threshold"
                    ]
                  },
                  "melt_rate_m_s"
                ]
              },
              0.0
            ]
          }
        },
        {
          "lhs": "retreat_rate_m_day",
          "rhs": {
            "op": "*",
            "args": [
              "retreat_rate_m_s",
              "seconds_per_day"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "default_config_zero_on_floating_shelf",
          "description": "Default config (frontal_melt.include_floating_ice = no): the fully floating van der Veen shelf has no grounded ice, so the melt rate is zero everywhere (melt at an interior floating cell (0,0) and at the front cell (60,0); stage1/dumps/calving/frontal_melt_constant.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 3,
            "include_floating_ice": 0
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "melt_rate_m_s",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "default_config_front_cell_zero",
          "description": "Default config at the front cell (i=60, j=0, H_threshold = 188.7737745520679 m): the melt rate and the retreat rate are both zero (no grounded ice to melt).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 4,
            "next_to_ice": 1,
            "include_floating_ice": 0,
            "H_threshold": 188.7737745520679,
            "sea_level": 0.0,
            "bed": -1000.0
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "retreat_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "include_floating_icy_cell_melt",
          "description": "With frontal_melt.include_floating_ice = yes, an interior floating cell (0,0) melts at the constant rate: melt_rate = 1 m/day = 1.1574074074074073e-05 m/s.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 3,
            "include_floating_ice": 1
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 1.0,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "melt_rate_m_s",
              "time": 0.0,
              "expected": 1.1574074074074073e-05,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "include_floating_ocean_not_next_to_ice",
          "description": "With include_floating_ice = yes, an ice-free-ocean cell NOT next to ice (i=61, j=32 of the dump) has melt rate 0.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 4,
            "next_to_ice": 0,
            "include_floating_ice": 1
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "include_floating_front_retreat",
          "description": "With include_floating_ice = yes at the front cell (i=60, j=0, H_threshold = 188.7737745520679 m, sea_level = 0, bed = -1000): the front is floating (H_threshold < h_f = 1129.67 m), so H_submerged = (rho_i/rho_w)*H_threshold = 167.10518953539082 m and the retreat rate = (H_submerged/H_threshold)*melt_rate = (rho_i/rho_w)*1 m/day = 0.88521400778210102 m/day (stage1/dumps/calving/frontal_melt_constant.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 4,
            "next_to_ice": 1,
            "include_floating_ice": 1,
            "H_threshold": 188.7737745520679,
            "sea_level": 0.0,
            "bed": -1000.0
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 1.0,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "H_submerged",
              "time": 0.0,
              "expected": 167.10518953539082,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "retreat_rate_m_day",
              "time": 0.0,
              "expected": 0.885214007782101,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "grounded_front_retreat_synthetic",
          "description": "A grounded front (H_threshold = 2000 m > h_f = 1129.67 m, sea_level = 0, bed = -1000): H_submerged = max(sea_level - bed, 0) = 1000 m and retreat = (1000/2000)*melt rate = 0.5 m/day (synthetic tuple exercising the grounded branch of compute_retreat_rate).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 4,
            "next_to_ice": 1,
            "include_floating_ice": 1,
            "H_threshold": 2000.0,
            "sea_level": 0.0,
            "bed": -1000.0
          },
          "assertions": [
            {
              "variable": "H_submerged",
              "time": 0.0,
              "expected": 1000.0,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "retreat_rate_m_day",
              "time": 0.0,
              "expected": 0.5,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "flag0_i00_j00",
          "description": "Default config (include_floating_ice = no) at (i=0, j=0, mask = 3): the fully floating shelf has no grounded ice, so the melt rate (and the retreat rate) are zero (stage1/dumps/calving/frontal_melt_constant.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 3,
            "next_to_ice": 0,
            "include_floating_ice": 0,
            "sea_level": 0.0,
            "bed": -1000.0
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "melt_rate_m_s",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "retreat_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "flag0_i58_j00",
          "description": "Default config (include_floating_ice = no) at (i=58, j=0, mask = 3): the fully floating shelf has no grounded ice, so the melt rate (and the retreat rate) are zero (stage1/dumps/calving/frontal_melt_constant.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "mask": 3,
            "next_to_ice": 0,
            "include_floating_ice": 0,
            "sea_level": 0.0,
            "bed": -1000.0
          },
          "assertions": [
            {
              "variable": "melt_rate_m_day",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
              }
            },
            {
              "variable": "melt_rate_m_s",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-30
