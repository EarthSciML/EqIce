          "default": 0.0,
          "description": "dv/dy"
        },
        "gamma": {
          "type": "unknown",
          "units": "1/s^2",
          "description": "squared second invariant gamma = 0.5 D_ij D_ij"
        }
      },
      "equations": [
        {
          "_comment": "secondInvariant_2D",
          "lhs": "gamma",
          "rhs": {
            "op": "second_invariant",
