    "EffectiveViscosity": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "B": {
          "type": "parameter",
          "units": "Pa s^(1/3)",
          "default": 10000.0,
          "description": "ice hardness"
        },
        "gamma": {
          "type": "parameter",
          "units": "1/s^2",
          "default": 1e-14,
          "description": "second invariant of the strain-rate tensor"
        },
        "eps": {
          "type": "parameter",
          "units": "1/s^2",
          "default": 0.0,
          "description": "Schoof regularization (flow_law.Schoof_regularizing_velocity / flow_law.Schoof_regularizing_length squared)"
        },
        "n": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Glen exponent (stress_balance.sia.Glen_exponent)"
        },
        "nu": {
          "type": "unknown",
          "units": "Pa s",
          "description": "regularized effective viscosity"
        },
        "dnu": {
          "type": "unknown",
          "units": "Pa s^3",
          "description": "derivative of effective viscosity with respect to gamma"
        }
      },
      "equations": [
        {
          "_comment": "FlowLaw::effective_viscosity",
          "lhs": "nu",
          "rhs": {
            "op": "effective_viscosity",
            "args": [
              "B",
              "gamma",
              "eps",
              "n"
            ]
          }
        },
        {
          "_comment": "FlowLaw::effective_viscosity (dnu output)",
          "lhs": "dnu",
          "rhs": {
            "op": "effective_viscosity_derivative",
            "args": [
              "B",
              "gamma",
              "eps",
              "n"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "tuple_1_zero",
          "description": "Effective viscosity: B=10000 Pa s^(1/3), gamma=1e-14 s^-2, eps=0 (stage1/dumps/rheology/effective_viscosity_isothermal_glen.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "B": 10000,
            "gamma": 1e-14,
            "eps": 0.0,
            "n": 3.0
          },
          "assertions": [
            {
              "variable": "nu",
              "time": 0.0,
              "expected": 232079441.68063882,
              "tolerance": {
                "rel": 1e-12
