          ]
        },
        {
          "id": "tuple_2_schoof",
          "description": "Effective viscosity: B=10000 Pa s^(1/3), gamma=1e-06 s^-2, eps=Schoof regularization (stage1/dumps/rheology/effective_viscosity_isothermal_glen.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
