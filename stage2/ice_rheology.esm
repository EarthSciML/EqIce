    "FlowLawArrheniusWarm": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "stress": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000.0,
          "description": "effective stress"
        },
        "E": {
          "type": "parameter",
          "units": "J/kg",
          "default": 0.0,
          "description": "ice enthalpy"
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "ice pressure"
        },
        "gs": {
          "type": "parameter",
          "units": "m",
          "default": 0.001,
          "description": "grain size (unused by this law)"
        },
        "n": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Glen exponent (stress_balance.sia.Glen_exponent)"
        },
        "c_ice": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 2009.0,
          "description": "specific heat capacity of ice (constants.ice.specific_heat_capacity)"
        },
        "c_water": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 4170.0,
          "description": "specific heat capacity of fresh water (constants.fresh_water.specific_heat_capacity)"
        },
        "L_0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "T_0": {
          "type": "parameter",
          "units": "K",
          "default": 223.15,
          "description": "reference temperature (enthalpy_converter.T_reference)"
        },
        "T_melting": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point temperature (constants.fresh_water.melting_point_temperature)"
        },
        "beta_Clausius_Clapeyron": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "R_ideal_gas": {
          "type": "parameter",
          "units": "J/(mol K)",
          "default": 8.31441,
          "description": "ideal gas constant (constants.ideal_gas_constant)"
        },
        "A_warm": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 1730.0,
          "description": "Arrhenius warm-case softness prefactor (flow_law.Paterson_Budd.A_warm)"
        },
        "Q_warm": {
          "type": "parameter",
          "units": "J/mol",
          "default": 139000.0,
          "description": "Arrhenius warm-case activation energy (flow_law.Paterson_Budd.Q_warm)"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "description": "absolute ice temperature T(E,p)"
        },
        "T_pa": {
          "type": "unknown",
          "units": "K",
          "description": "pressure-adjusted temperature T_pa(E,p)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "liquid water fraction omega(E,p)"
        },
        "is_temperate": {
          "type": "unknown",
          "units": "1",
          "description": "1 if E >= E_s(p)"
        },
        "softness": {
          "type": "unknown",
          "units": "Pa^-3/s",
          "description": "ice softness A (computed from T_pa)"
        },
        "hardness": {
          "type": "unknown",
          "units": "Pa s^(1/3)",
          "description": "ice hardness B = A^(-1/n)"
        },
        "flow": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "flow factor A*sigma^(n-1)"
        }
      },
      "equations": [
        {
          "_comment": "EnthalpyConverter::temperature",
          "lhs": "T",
          "rhs": {
            "op": "enthalpy_to_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::pressure_adjusted_temperature",
          "lhs": "T_pa",
          "rhs": {
            "op": "pressure_adjusted_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::water_fraction",
          "lhs": "omega",
          "rhs": {
            "op": "water_fraction",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::is_temperate",
          "lhs": "is_temperate",
          "rhs": {
            "op": ">=",
            "args": [
              "E",
              {
                "op": "cold_temperate_enthalpy",
                "args": [
                  "p"
                ]
              }
            ]
          }
        },
        {
          "_comment": "PatersonBuddWarm::softness_from_temp (softness uses T_pa)",
          "lhs": "softness",
          "rhs": {
            "op": "arrhenius_softness",
            "args": [
              "A_warm",
              "Q_warm",
              "T_pa"
            ]
          }
        },
        {
          "_comment": "FlowLaw::hardness_impl",
          "lhs": "hardness",
          "rhs": {
            "op": "hardness_from_softness",
            "args": [
              "softness",
              "n"
            ]
          }
        },
        {
          "_comment": "PatersonBuddWarm::flow_from_temp ignores pressure and uses the NON-pressure-adjusted temperature",
          "lhs": "flow",
          "rhs": {
            "op": "flow_power_law",
            "args": [
              {
                "op": "arrhenius_softness",
                "args": [
                  "A_warm",
                  "Q_warm",
                  "T"
                ]
              },
              "stress",
              "n"
            ]
          }
        }
      ],
