            "args": [
              "softness",
              "n"
            ]
          }
        },
        {
          "_comment": "PatersonBudd::flow_impl (flow uses the pressure-adjusted temperature)",
          "lhs": "flow",
          "rhs": {
            "op": "flow_power_law",
            "args": [
              "softness",
              "stress",
              "n"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "tuple_1",
          "description": "Flow-law point: stress=1000.0 Pa, E=0.0 J/kg, p=0.0 Pa, grain size=0.001 m (stage1/dumps/rheology/flowlaw_hooke.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "stress": 1000.0,
            "E": 0.0,
            "p": 0.0,
            "gs": 0.001
          },
          "assertions": [
            {
              "variable": "softness",
