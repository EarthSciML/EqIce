        },
        "A_cold": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 3.61e-13,
          "description": "Arrhenius cold-case softness prefactor (flow_law.Paterson_Budd.A_cold)"
        },
        "Q_cold": {
          "type": "parameter",
          "units": "J/mol",
          "default": 60000.0,
          "description": "Arrhenius cold-case activation energy (flow_law.Paterson_Budd.Q_cold)"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "description": "absolute ice temperature T(E,p)"
        },
        "T_pa": {
          "type": "unknown",
          "units": "K",
          "description": "pressure-adjusted temperature T_pa(E,p)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "liquid water fraction omega(E,p)"
        },
        "is_temperate": {
          "type": "unknown",
          "units": "1",
          "description": "1 if E >= E_s(p)"
        },
