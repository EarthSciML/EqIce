    "FlowLawGoldsbyKohlstedt": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "stress": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000.0,
          "description": "effective stress"
        },
        "E": {
          "type": "parameter",
          "units": "J/kg",
          "default": 0.0,
          "description": "ice enthalpy"
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "ice pressure"
        },
        "gs": {
          "type": "parameter",
          "units": "m",
          "default": 0.001,
          "description": "grain size"
        },
        "n": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Glen exponent used for the hardness factor (stress_balance.sia.Glen_exponent)"
        },
        "c_ice": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 2009.0,
          "description": "specific heat capacity of ice (constants.ice.specific_heat_capacity)"
        },
        "c_water": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 4170.0,
          "description": "specific heat capacity of fresh water (constants.fresh_water.specific_heat_capacity)"
        },
        "L_0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "T_0": {
          "type": "parameter",
          "units": "K",
          "default": 223.15,
          "description": "reference temperature (enthalpy_converter.T_reference)"
        },
        "T_melting": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point temperature (constants.fresh_water.melting_point_temperature)"
        },
        "beta_Clausius_Clapeyron": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "R_ideal_gas": {
          "type": "parameter",
          "units": "J/(mol K)",
          "default": 8.31441,
          "description": "ideal gas constant (constants.ideal_gas_constant)"
        },
        "A_cold": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 3.61e-13,
          "description": "Paterson-Budd cold-branch softness prefactor (flow_law.Paterson_Budd.A_cold)"
        },
        "A_warm": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 1730.0,
          "description": "Paterson-Budd warm-branch softness prefactor (flow_law.Paterson_Budd.A_warm)"
        },
        "Q_cold": {
          "type": "parameter",
          "units": "J/mol",
          "default": 60000.0,
          "description": "Paterson-Budd cold-branch activation energy (flow_law.Paterson_Budd.Q_cold)"
        },
        "Q_warm": {
          "type": "parameter",
          "units": "J/mol",
          "default": 139000.0,
          "description": "Paterson-Budd warm-branch activation energy (flow_law.Paterson_Budd.Q_warm)"
        },
        "T_critical": {
          "type": "parameter",
          "units": "K",
          "default": 263.15,
          "description": "Paterson-Budd cold/warm transition temperature (flow_law.Paterson_Budd.T_critical)"
        },
        "V_act_vol": {
          "type": "parameter",
          "units": "m^3/mol",
          "default": -1.3e-05,
          "description": "GK activation volume (GoldsbyKohlstedt::m_V_act_vol)"
        },
        "disl_A_cold": {
          "type": "parameter",
          "units": "Pa^-4/s",
          "default": 4e-19,
          "description": "GK dislocation-creep cold prefactor (GoldsbyKohlstedt::m_disl_A_cold)"
        },
        "disl_A_warm": {
          "type": "parameter",
          "units": "Pa^-4/s",
          "default": 60000.0,
          "description": "GK dislocation-creep warm prefactor (GoldsbyKohlstedt::m_disl_A_warm)"
        },
        "disl_n": {
          "type": "parameter",
          "units": "1",
          "default": 4.0,
          "description": "GK dislocation-creep stress exponent (GoldsbyKohlstedt::m_disl_n)"
        },
        "disl_Q_cold": {
          "type": "parameter",
          "units": "J/mol",
          "default": 60000.0,
          "description": "GK dislocation-creep cold activation energy (GoldsbyKohlstedt::m_disl_Q_cold)"
        },
        "disl_Q_warm": {
          "type": "parameter",
          "units": "J/mol",
          "default": 180000.0,
          "description": "GK dislocation-creep warm activation energy (GoldsbyKohlstedt::m_disl_Q_warm)"
        },
        "disl_crit_temp": {
          "type": "parameter",
          "units": "K",
          "default": 258.0,
          "description": "GK dislocation-creep cold/warm transition temperature (GoldsbyKohlstedt::m_disl_crit_temp)"
        },
        "gbs_A_cold": {
          "type": "parameter",
          "units": "Pa^-1.8 m^1.4 / s",
          "default": 6.1811e-14,
          "description": "GK grain-boundary-sliding cold prefactor (GoldsbyKohlstedt::m_gbs_A_cold)"
        },
        "gbs_A_warm": {
          "type": "parameter",
          "units": "Pa^-1.8 m^1.4 / s",
          "default": 4754700000000000.0,
          "description": "GK grain-boundary-sliding warm prefactor (GoldsbyKohlstedt::m_gbs_A_warm)"
        },
        "gbs_n": {
          "type": "parameter",
          "units": "1",
          "default": 1.8,
          "description": "GK grain-boundary-sliding stress exponent (GoldsbyKohlstedt::m_gbs_n)"
        },
        "gbs_Q_cold": {
          "type": "parameter",
          "units": "J/mol",
          "default": 49000.0,
          "description": "GK grain-boundary-sliding cold activation energy (GoldsbyKohlstedt::m_gbs_Q_cold)"
        },
        "gbs_Q_warm": {
          "type": "parameter",
          "units": "J/mol",
          "default": 192000.0,
          "description": "GK grain-boundary-sliding warm activation energy (GoldsbyKohlstedt::m_gbs_Q_warm)"
        },
        "gbs_crit_temp": {
          "type": "parameter",
          "units": "K",
          "default": 255.0,
          "description": "GK grain-boundary-sliding cold/warm transition temperature (GoldsbyKohlstedt::m_gbs_crit_temp)"
        },
        "p_grain_sz_exp": {
          "type": "parameter",
          "units": "1",
          "default": 1.4,
          "description": "GK grain-size exponent (GoldsbyKohlstedt::m_p_grain_sz_exp)"
        },
        "basal_A": {
          "type": "parameter",
          "units": "Pa^-2.4/s",
          "default": 2.1896e-07,
          "description": "GK basal-slip prefactor (GoldsbyKohlstedt::m_basal_A)"
        },
        "basal_n": {
          "type": "parameter",
          "units": "1",
          "default": 2.4,
          "description": "GK basal-slip stress exponent (GoldsbyKohlstedt::m_basal_n)"
        },
        "basal_Q": {
          "type": "parameter",
          "units": "J/mol",
          "default": 60000.0,
          "description": "GK basal-slip activation energy (GoldsbyKohlstedt::m_basal_Q)"
        },
        "diff_crit_temp": {
          "type": "parameter",
          "units": "K",
          "default": 258.0,
          "description": "GK diffusional-flow Coble-scaling transition temperature (GoldsbyKohlstedt::m_diff_crit_temp)"
        },
        "diff_V_m": {
          "type": "parameter",
          "units": "m^3/mol",
          "default": 1.97e-05,
          "description": "GK molar volume (GoldsbyKohlstedt::m_diff_V_m)"
        },
        "diff_D_0v": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.00091,
          "description": "GK volume-diffusion prefactor (GoldsbyKohlstedt::m_diff_D_0v)"
        },
        "diff_Q_v": {
          "type": "parameter",
          "units": "J/mol",
          "default": 59400.0,
          "description": "GK volume-diffusion activation energy (GoldsbyKohlstedt::m_diff_Q_v)"
        },
        "diff_D_0b": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.00058,
          "description": "GK grain-boundary-diffusion prefactor (GoldsbyKohlstedt::m_diff_D_0b)"
        },
        "diff_Q_b": {
          "type": "parameter",
          "units": "J/mol",
          "default": 49000.0,
          "description": "GK grain-boundary-diffusion activation energy (GoldsbyKohlstedt::m_diff_Q_b)"
        },
        "diff_delta": {
          "type": "parameter",
          "units": "m",
          "default": 9.04e-10,
          "description": "GK grain-boundary width (GoldsbyKohlstedt::m_diff_delta)"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "description": "absolute ice temperature T(E,p)"
        },
        "T_pa": {
          "type": "unknown",
          "units": "K",
          "description": "pressure-adjusted temperature T_pa(E,p) (the temperature used by the GK strain-rate terms)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "liquid water fraction omega(E,p)"
        },
        "is_temperate": {
          "type": "unknown",
          "units": "1",
          "description": "1 if E >= E_s(p)"
        },
        "hardness": {
          "type": "unknown",
          "units": "Pa s^(1/3)",
          "description": "ice hardness B = A^(-1/n) with the Paterson-Budd softness at T_pa (GoldsbyKohlstedt::hardness_impl)"
        },
        "eps_diff": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "GK diffusional-flow contribution"
        },
        "eps_disl": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "GK dislocation-creep contribution"
        },
        "eps_basal": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "GK basal-slip contribution"
        },
        "eps_gbs": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "GK grain-boundary-sliding contribution"
        },
        "flow": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "GK hybrid flow factor"
        }
      },
      "equations": [
        {
          "_comment": "EnthalpyConverter::temperature",
          "lhs": "T",
          "rhs": {
            "op": "enthalpy_to_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::pressure_adjusted_temperature",
          "lhs": "T_pa",
          "rhs": {
            "op": "pressure_adjusted_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::water_fraction",
          "lhs": "omega",
          "rhs": {
            "op": "water_fraction",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::is_temperate",
          "lhs": "is_temperate",
          "rhs": {
            "op": ">=",
            "args": [
              "E",
              {
                "op": "cold_temperate_enthalpy",
                "args": [
                  "p"
                ]
              }
            ]
          }
        },
        {
          "_comment": "GoldsbyKohlstedt::hardness_impl (Paterson-Budd softness at T_pa)",
          "lhs": "hardness",
          "rhs": {
            "op": "hardness_from_softness",
            "args": [
              {
                "op": "pb_softness",
                "args": [
                  "T_pa"
                ]
              },
              "n"
            ]
          }
        },
        {
          "_comment": "GoldsbyKohlstedt::flow_from_temp, diffusional flow (temperature used is T_pa = temp + beta*p)",
          "lhs": "eps_diff",
          "rhs": {
            "op": "gk_diffusional_strain_rate",
            "args": [
              "stress",
              "T_pa",
              "gs"
            ]
          }
        },
        {
          "_comment": "GoldsbyKohlstedt::flow_from_temp, dislocation creep",
          "lhs": "eps_disl",
          "rhs": {
            "op": "gk_dislocation_strain_rate",
            "args": [
              "stress",
              "T_pa",
              "p"
            ]
          }
        },
        {
          "_comment": "GoldsbyKohlstedt::flow_from_temp, basal slip",
          "lhs": "eps_basal",
          "rhs": {
            "op": "gk_basal_strain_rate",
            "args": [
              "stress",
              "T_pa",
              "p"
            ]
          }
        },
        {
          "_comment": "GoldsbyKohlstedt::flow_from_temp, grain-boundary sliding",
          "lhs": "eps_gbs",
          "rhs": {
            "op": "gk_gbs_strain_rate",
            "args": [
              "stress",
              "T_pa",
              "p",
              "gs"
            ]
          }
        },
        {
          "_comment": "GoldsbyKohlstedt::flow_from_temp, total (zero below |stress| < 1e-10)",
          "lhs": "flow",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<",
                "args": [
                  {
                    "op": "abs",
                    "args": [
                      "stress"
                    ]
                  },
                  1e-10
                ]
              },
              0.0,
              {
                "op": "+",
                "args": [
                  "eps_diff",
                  "eps_disl",
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "eps_basal",
                          "eps_gbs"
                        ]
                      },
                      {
                        "op": "+",
                        "args": [
                          "eps_basal",
                          "eps_gbs"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "tuple_1",
          "description": "Flow-law point: stress=1000.0 Pa, E=0.0 J/kg, p=0.0 Pa, grain size=0.001 m (stage1/dumps/rheology/flowlaw_gk.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "stress": 1000.0,
            "E": 0.0,
            "p": 0.0,
            "gs": 0.001
          },
          "assertions": [
            {
              "variable": "hardness",
              "time": 0.0,
              "expected": 674540228.7500812,
              "tolerance": {
                "rel": 1e-09
              }
            },
            {
              "variable": "flow",
              "time": 0.0,
              "expected": 5.8763057376314714e-18,
              "tolerance": {
                "rel": 1e-09
              }
            },
            {
              "variable": "T",
              "time": 0.0,
              "expected": 223.15,
              "tolerance": {
                "rel": 1e-09
              }
            },
            {
              "variable": "T_pa",
              "time": 0.0,
              "expected": 223.15,
              "tolerance": {
                "rel": 1e-09
              }
            },
            {
              "variable": "omega",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "rel": 1e-09
              }
            },
            {
              "variable": "is_temperate",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "rel": 1e-09
              }
            }
          ]
        },
        {
          "id": "tuple_2",
          "description": "Flow-law point: stress=1000.0 Pa, E=95000.0 J/kg, p=45000000.0 Pa, grain size=0.001 m (stage1/dumps/rheology/flowlaw_gk.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "stress": 1000.0,
            "E": 95000.0,
            "p": 45000000.0,
            "gs": 0.001
          },
          "assertions": [
            {
              "variable": "hardness",
              "time": 0.0,
              "expected": 60378981.02086895,
              "tolerance": {
                "rel": 1e-09
              }
            },
            {
              "variable": "flow",
              "time": 0.0,
              "expected": 5.2970282563825745e-15,
              "tolerance": {
                "rel": 1e-09
              }
