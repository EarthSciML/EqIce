{
  "esm": "1.0.0",
  "metadata": {
    "name": "ice_rheology",
    "description": "PISM ice-rheology component (stage 2 of the eqice project): the enthalpy converter (E,p -> T, T_pa, omega, is_temperate, E_cts, E_l, T_m), the Glen-Nye flow laws selectable through FlowLawFactory (isothermal Glen, Paterson-Budd, Arrhenius cold/warm, GPBLD, Hooke, Goldsby-Kohlstedt), the regularized effective viscosity, and the shallow-shelf second invariant. All shared math is imported by reference from ./ice_rheology_templates.esm. Tests assert the instantaneous FlowLaw/EnthalpyConverter/effective-viscosity/second-invariant boundary outputs dumped by the instrumented PISM v2.3.2 run (stage1/dumps/rheology/)."
  },
  "models": {
    "EnthalpyConverter": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "E": {
          "type": "parameter",
          "units": "J/kg",
          "default": 0.0,
          "description": "ice enthalpy"
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "ice pressure"
        },
        "c_ice": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 2009.0,
          "description": "specific heat capacity of ice (constants.ice.specific_heat_capacity)"
        },
        "c_water": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 4170.0,
          "description": "specific heat capacity of fresh water (constants.fresh_water.specific_heat_capacity)"
        },
        "L_0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "T_0": {
          "type": "parameter",
          "units": "K",
          "default": 223.15,
          "description": "reference temperature (enthalpy_converter.T_reference)"
        },
        "T_melting": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point temperature (constants.fresh_water.melting_point_temperature)"
        },
        "beta_Clausius_Clapeyron": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "T_m": {
          "type": "unknown",
          "units": "K",
          "description": "pressure melting temperature T_m(p)"
        },
        "E_cts": {
          "type": "unknown",
          "units": "J/kg",
          "description": "cold-temperate transition enthalpy E_s(p)"
        },
        "E_l": {
          "type": "unknown",
          "units": "J/kg",
          "description": "enthalpy of liquid water E_l(p)"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "description": "absolute ice temperature T(E,p)"
        },
        "T_pa": {
          "type": "unknown",
          "units": "K",
          "description": "pressure-adjusted temperature T_pa(E,p)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "liquid water fraction omega(E,p)"
        },
        "is_temperate": {
          "type": "unknown",
          "units": "1",
          "description": "1 if E >= E_s(p) (energy.model = enthalpy)"
        }
      },
      "equations": [
        {
          "_comment": "EnthalpyConverter::melting_temperature",
          "lhs": "T_m",
          "rhs": {
            "op": "pressure_melting_temperature",
            "args": [
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::enthalpy_cts",
          "lhs": "E_cts",
          "rhs": {
            "op": "cold_temperate_enthalpy",
            "args": [
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::enthalpy_liquid",
          "lhs": "E_l",
          "rhs": {
            "op": "+",
            "args": [
              "E_cts",
              {
                "op": "latent_heat_fusion",
                "args": [
                  "T_m"
                ]
              }
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::temperature",
          "lhs": "T",
          "rhs": {
            "op": "enthalpy_to_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::pressure_adjusted_temperature",
          "lhs": "T_pa",
          "rhs": {
            "op": "pressure_adjusted_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::water_fraction",
          "lhs": "omega",
          "rhs": {
            "op": "water_fraction",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::is_temperate for energy.model = enthalpy",
          "lhs": "is_temperate",
          "rhs": {
            "op": ">=",
            "args": [
              "E",
              {
                "op": "cold_temperate_enthalpy",
                "args": [
                  "p"
                ]
              }
            ]
          }
        }
      ],
      "tests": [
