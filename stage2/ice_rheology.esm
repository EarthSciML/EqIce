                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "tuple_2_zero",
          "description": "Effective viscosity: B=10000 Pa s^(1/3), gamma=1e-06 s^-2, eps=0 (stage1/dumps/rheology/effective_viscosity_isothermal_glen.csv).",
          "time_span": {
