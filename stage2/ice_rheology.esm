    "FlowLawIsothermalGlen": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "stress": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000.0,
          "description": "effective stress"
        },
        "E": {
          "type": "parameter",
          "units": "J/kg",
          "default": 0.0,
          "description": "ice enthalpy"
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "ice pressure"
        },
        "gs": {
          "type": "parameter",
          "units": "m",
          "default": 0.001,
          "description": "grain size (unused by this law)"
        },
        "n": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Glen exponent (stress_balance.sia.Glen_exponent)"
        },
        "c_ice": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 2009.0,
          "description": "specific heat capacity of ice (constants.ice.specific_heat_capacity)"
        },
        "c_water": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 4170.0,
          "description": "specific heat capacity of fresh water (constants.fresh_water.specific_heat_capacity)"
        },
        "L_0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "T_0": {
          "type": "parameter",
          "units": "K",
          "default": 223.15,
          "description": "reference temperature (enthalpy_converter.T_reference)"
        },
        "T_melting": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point temperature (constants.fresh_water.melting_point_temperature)"
        },
        "beta_Clausius_Clapeyron": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "R_ideal_gas": {
          "type": "parameter",
          "units": "J/(mol K)",
          "default": 8.31441,
          "description": "ideal gas constant (constants.ideal_gas_constant)"
        },
        "A_isothermal_glen": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 3.1689e-24,
          "description": "isothermal-Glen ice softness (flow_law.isothermal_Glen.ice_softness)"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "description": "absolute ice temperature T(E,p)"
        },
        "T_pa": {
          "type": "unknown",
          "units": "K",
          "description": "pressure-adjusted temperature T_pa(E,p)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "liquid water fraction omega(E,p)"
        },
        "is_temperate": {
          "type": "unknown",
          "units": "1",
          "description": "1 if E >= E_s(p)"
        },
        "softness": {
          "type": "unknown",
          "units": "Pa^-3/s",
          "description": "ice softness A"
        },
        "hardness": {
          "type": "unknown",
          "units": "Pa s^(1/3)",
          "description": "ice hardness B = A^(-1/n)"
        },
        "flow": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "flow factor A*sigma^(n-1)"
        }
      },
      "equations": [
        {
          "_comment": "EnthalpyConverter::temperature",
          "lhs": "T",
          "rhs": {
            "op": "enthalpy_to_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::pressure_adjusted_temperature",
          "lhs": "T_pa",
          "rhs": {
            "op": "pressure_adjusted_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::water_fraction",
          "lhs": "omega",
          "rhs": {
            "op": "water_fraction",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::is_temperate",
          "lhs": "is_temperate",
          "rhs": {
            "op": ">=",
            "args": [
              "E",
              {
                "op": "cold_temperate_enthalpy",
                "args": [
                  "p"
                ]
              }
            ]
          }
        },
        {
          "_comment": "IsothermalGlen::softness_impl",
          "lhs": "softness",
          "rhs": "A_isothermal_glen"
        },
        {
          "_comment": "FlowLaw::hardness_impl",
          "lhs": "hardness",
          "rhs": {
            "op": "hardness_from_softness",
            "args": [
              "softness",
              "n"
            ]
          }
        },
        {
          "_comment": "IsothermalGlen::flow_impl",
          "lhs": "flow",
          "rhs": {
            "op": "flow_power_law",
            "args": [
              "softness",
              "stress",
              "n"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "tuple_1",
          "description": "Flow-law point: stress=1000.0 Pa, E=0.0 J/kg, p=0.0 Pa, grain size=0.001 m (stage1/dumps/rheology/flowlaw_isothermal_glen.csv).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "stress": 1000.0,
            "E": 0.0,
            "p": 0.0,
            "gs": 0.001
          },
          "assertions": [
            {
              "variable": "softness",
              "time": 0.0,
              "expected": 3.1689e-24,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "hardness",
              "time": 0.0,
              "expected": 68081715.1985767,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "flow",
              "time": 0.0,
              "expected": 3.1688999999999998e-18,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "T",
              "time": 0.0,
              "expected": 223.15,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "T_pa",
              "time": 0.0,
              "expected": 223.15,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "omega",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "is_temperate",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "tuple_2",
          "description": "Flow-law point: stress=1000.0 Pa, E=95000.0 J/kg, p=45000000.0 Pa, grain size=0.001 m (stage1/dumps/rheology/flowlaw_isothermal_glen.csv).",
          "time_span": {
