    "FlowLawGPBLD": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "stress": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000.0,
          "description": "effective stress"
        },
        "E": {
          "type": "parameter",
          "units": "J/kg",
          "default": 0.0,
          "description": "ice enthalpy"
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "ice pressure"
        },
        "gs": {
          "type": "parameter",
          "units": "m",
          "default": 0.001,
          "description": "grain size (unused by this law)"
        },
        "n": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Glen exponent (stress_balance.sia.Glen_exponent)"
        },
        "c_ice": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 2009.0,
          "description": "specific heat capacity of ice (constants.ice.specific_heat_capacity)"
        },
        "c_water": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 4170.0,
          "description": "specific heat capacity of fresh water (constants.fresh_water.specific_heat_capacity)"
        },
        "L_0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "T_0": {
          "type": "parameter",
          "units": "K",
          "default": 223.15,
          "description": "reference temperature (enthalpy_converter.T_reference)"
        },
        "T_melting": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point temperature (constants.fresh_water.melting_point_temperature)"
        },
        "beta_Clausius_Clapeyron": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "R_ideal_gas": {
          "type": "parameter",
          "units": "J/(mol K)",
          "default": 8.31441,
          "description": "ideal gas constant (constants.ideal_gas_constant)"
        },
        "A_cold": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 3.61e-13,
          "description": "Paterson-Budd cold-branch softness prefactor (flow_law.Paterson_Budd.A_cold)"
        },
        "A_warm": {
          "type": "parameter",
          "units": "Pa^-3/s",
          "default": 1730.0,
          "description": "Paterson-Budd warm-branch softness prefactor (flow_law.Paterson_Budd.A_warm)"
        },
        "Q_cold": {
          "type": "parameter",
          "units": "J/mol",
          "default": 60000.0,
          "description": "Paterson-Budd cold-branch activation energy (flow_law.Paterson_Budd.Q_cold)"
        },
        "Q_warm": {
          "type": "parameter",
          "units": "J/mol",
          "default": 139000.0,
          "description": "Paterson-Budd warm-branch activation energy (flow_law.Paterson_Budd.Q_warm)"
        },
        "T_critical": {
          "type": "parameter",
          "units": "K",
          "default": 263.15,
          "description": "Paterson-Budd cold/warm transition temperature (flow_law.Paterson_Budd.T_critical)"
        },
        "water_frac_coeff": {
          "type": "parameter",
          "units": "1",
          "default": 181.25,
          "description": "GPBLD water-fraction coefficient (flow_law.gpbld.water_frac_coeff)"
        },
        "water_frac_observed_limit": {
          "type": "parameter",
          "units": "1",
          "default": 0.01,
          "description": "GPBLD observed water-fraction cap (flow_law.gpbld.water_frac_observed_limit)"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "description": "absolute ice temperature T(E,p)"
        },
        "T_pa": {
          "type": "unknown",
          "units": "K",
          "description": "pressure-adjusted temperature T_pa(E,p)"
        },
        "omega": {
          "type": "unknown",
          "units": "1",
          "description": "liquid water fraction omega(E,p)"
        },
        "is_temperate": {
          "type": "unknown",
          "units": "1",
          "description": "1 if E >= E_s(p)"
        },
        "E_cts": {
          "type": "unknown",
          "units": "J/kg",
          "description": "cold-temperate transition enthalpy E_s(p)"
        },
        "softness": {
          "type": "unknown",
          "units": "Pa^-3/s",
          "description": "ice softness A"
        },
        "hardness": {
          "type": "unknown",
          "units": "Pa s^(1/3)",
          "description": "ice hardness B = A^(-1/n)"
        },
        "flow": {
          "type": "unknown",
          "units": "Pa^-1/s",
          "description": "flow factor A*sigma^(n-1)"
        }
      },
      "equations": [
        {
          "_comment": "EnthalpyConverter::temperature",
          "lhs": "T",
          "rhs": {
            "op": "enthalpy_to_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::pressure_adjusted_temperature",
          "lhs": "T_pa",
          "rhs": {
            "op": "pressure_adjusted_temperature",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::water_fraction",
          "lhs": "omega",
          "rhs": {
            "op": "water_fraction",
            "args": [
              "E",
              "p"
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::is_temperate",
          "lhs": "is_temperate",
          "rhs": {
            "op": ">=",
            "args": [
              "E",
              {
                "op": "cold_temperate_enthalpy",
                "args": [
                  "p"
                ]
              }
            ]
          }
        },
        {
          "_comment": "EnthalpyConverter::enthalpy_cts",
          "lhs": "E_cts",
          "rhs": {
            "op": "cold_temperate_enthalpy",
            "args": [
              "p"
            ]
          }
        },
        {
          "_comment": "GPBLD::softness_impl: cold ice uses Paterson-Budd at T_pa; temperate ice uses Paterson-Budd at the melting point times (1 + C*min(omega, omega_observed_limit))",
          "lhs": "softness",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<",
                "args": [
                  "E",
                  "E_cts"
                ]
              },
              {
                "op": "pb_softness",
                "args": [
                  "T_pa"
                ]
              },
              {
                "op": "gpbld_temperate_softness",
                "args": [
                  "omega"
                ]
              }
            ]
          }
        },
        {
          "_comment": "FlowLaw::hardness_impl",
          "lhs": "hardness",
          "rhs": {
            "op": "hardness_from_softness",
            "args": [
              "softness",
              "n"
            ]
          }
        },
        {
          "_comment": "FlowLaw::flow_impl (softness times sigma^(n-1))",
          "lhs": "flow",
          "rhs": {
            "op": "flow_power_law",
            "args": [
              "softness",
              "stress",
              "n"
            ]
          }
        }
      ],
