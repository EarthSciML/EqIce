    "SecondInvariant": {
      "expression_template_imports": [
        {
          "ref": "./ice_rheology_templates.esm"
        }
      ],
      "variables": {
        "u_x": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "du/dx"
        },
        "u_y": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "du/dy"
        },
        "v_x": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "dv/dx"
        },
        "v_y": {
