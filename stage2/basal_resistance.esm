            { "variable": "tau_b_mag", "time": 0.0, "expected": 199999.99999899583, "tolerance": { "rel": 1e-12 } }
          ]
        }
      ]
    },
    "BasalResistancePseudoPlastic": {
      "expression_template_imports": [
        {
          "ref": "./basal_templates.esm"
        }
      ],
      "variables": {
        "tauc": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "yield stress"
        },
        "vx": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "horizontal ice velocity x-component at the bed"
        },
        "vy": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "horizontal ice velocity y-component at the bed"
        },
        "eps": {
          "type": "parameter",
          "units": "m/s",
          "default": 3.168876464081849e-10,
          "description": "Schoof plastic regularization 0.01 m/yr (basal_resistance.plastic.regularization)"
        },
        "q": {
          "type": "parameter",
          "units": "1",
          "default": 0.25,
          "description": "pseudo-plastic exponent (basal_resistance.pseudo_plastic.q)"
        },
        "u_threshold": {
          "type": "parameter",
          "units": "m/s",
          "default": 3.1688764640818492e-06,
          "description": "pseudo-plastic threshold speed 100 m/yr (basal_resistance.pseudo_plastic.u_threshold; the sliding_scale_factor branch is off by default, sliding_scale_factor = -1)"
        },
        "magreg2": {
          "type": "unknown",
          "units": "m^2/s^2",
          "description": "regularized squared sliding speed eps^2 + vx^2 + vy^2"
        },
        "mag_v": {
          "type": "unknown",
          "units": "m/s",
          "description": "sliding speed |v| = sqrt(vx^2 + vy^2)"
        },
        "beta": {
          "type": "unknown",
          "units": "Pa s/m",
          "description": "drag coefficient beta = tauc |v|^(q-1) u_threshold^(-q)"
        },
        "dbeta": {
          "type": "unknown",
          "units": "Pa s^3/m^3",
          "description": "d(beta)/d(alpha), alpha = 0.5 |v|^2: (q-1) beta/(eps^2 + v^2)"
        },
        "tau_b_mag": {
          "type": "unknown",
          "units": "Pa",
          "description": "basal shear stress magnitude |tau_b| = beta |v|"
        }
      },
      "equations": [
        {
          "_comment": "Regularized squared speed (IceBasalResistancePseudoPlasticLaw::drag).",
          "lhs": "magreg2",
          "rhs": {
            "op": "basal_speed_squared",
            "args": ["eps", "vx", "vy"]
          }
        },
        {
          "_comment": "Sliding speed (the |v| dump column).",
          "lhs": "mag_v",
          "rhs": {
            "op": "sqrt",
            "args": [
              { "op": "+", "args": [ { "op": "^", "args": ["vx", 2] }, { "op": "^", "args": ["vy", 2] } ] }
            ]
          }
        },
        {
          "_comment": "IceBasalResistancePseudoPlasticLaw::drag: beta = tauc * magreg2^((q-1)/2) * u_threshold^(-q).",
          "lhs": "beta",
          "rhs": {
            "op": "pseudo_plastic_drag",
            "args": ["tauc", "q", "u_threshold", "eps", "vx", "vy"]
          }
        },
        {
          "_comment": "IceBasalResistancePseudoPlasticLaw::drag_with_derivative: dbeta = (q-1) beta / magreg2.",
          "lhs": "dbeta",
          "rhs": {
            "op": "pseudo_plastic_drag_derivative",
            "args": ["tauc", "q", "u_threshold", "eps", "vx", "vy"]
          }
        },
        {
          "_comment": "Basal shear stress magnitude |tau_b| = beta |v| (the |tau_b| dump column).",
          "lhs": "tau_b_mag",
          "rhs": {
            "op": "*",
            "args": ["beta", "mag_v"]
          }
        }
      ],
      "tests": [
        {
