    "MohrCoulombYieldStress": {
      "expression_template_imports": [
        {
          "ref": "./basal_templates.esm"
        }
      ],
      "variables": {
        "rho_ice": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "standard gravity (constants.standard_gravity)"
        },
        "H": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "ice thickness"
        },
        "W_till": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "till water thickness (the pointwise model uses water = W_till: no slippery_grounding_lines, no add_transportable_water in the instrumented run)"
        },
        "phi_deg": {
          "type": "parameter",
          "units": "degrees",
          "default": 30.0,
          "description": "till friction angle in degrees"
        },
        "mask": {
          "type": "parameter",
          "units": "1",
          "default": 2,
          "description": "cell type mask: 0 = ice-free bedrock, 2 = grounded ice (PISM Mask.hh)"
        },
        "delta": {
          "type": "parameter",
          "units": "1",
          "default": 0.02,
          "description": "fraction of overburden pressure (basal_yield_stress.mohr_coulomb.till_effective_fraction_overburden; no delta forcing file in the run)"
        },
        "high_tauc": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000000.0,
          "description": "yield stress in ice-free areas (basal_yield_stress.ice_free_bedrock)"
        },
        "W_till_max": {
          "type": "parameter",
          "units": "m",
          "default": 2.0,
          "description": "maximum till water thickness (hydrology.tillwat_max)"
        },
        "till_cohesion": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "till cohesion c_0 (basal_yield_stress.mohr_coulomb.till_cohesion)"
        },
        "N0": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000.0,
          "description": "reference effective pressure (basal_yield_stress.mohr_coulomb.till_reference_effective_pressure)"
        },
        "e0": {
          "type": "parameter",
          "units": "1",
          "default": 0.69,
          "description": "reference void ratio (basal_yield_stress.mohr_coulomb.till_reference_void_ratio)"
        },
        "Cc": {
          "type": "parameter",
          "units": "1",
          "default": 0.12,
          "description": "till compressibility coefficient (basal_yield_stress.mohr_coulomb.till_compressibility_coefficient)"
        },
        "P_overburden": {
          "type": "unknown",
          "units": "Pa",
          "description": "overburden pressure rho_ice*g*H (MohrCoulombYieldStress::update_impl)"
        },
        "N_till": {
          "type": "unknown",
          "units": "Pa",
          "description": "effective pressure field min(P_overburden, Tulaczyk formula)"
        },
        "tauc": {
          "type": "unknown",
          "units": "Pa",
          "description": "basal yield stress: high_tauc in ice-free cells, c0 + tan(phi) N_till in grounded cells"
        }
      },
      "equations": [
        {
          "_comment": "MohrCoulombYieldStress::update_impl overburden pressure from ice thickness.",
          "lhs": "P_overburden",
          "rhs": {
            "op": "overburden_pressure",
            "args": [
              "rho_ice",
              "g",
              "H"
            ]
          }
        },
        {
          "_comment": "MohrCoulombYieldStress::update_impl effective pressure (recomputed pointwise by the instrument; the N_till column of tauc_map.csv).",
          "lhs": "N_till",
          "rhs": {
            "op": "mohr_coulomb_effective_pressure",
            "args": [
              "delta",
              "P_overburden",
              "W_till"
            ]
          }
        },
        {
          "_comment": "MohrCoulombYieldStress::update_impl: ice-free cells get the high yield stress basal_yield_stress.ice_free_bedrock; grounded cells the Mohr-Coulomb value.",
          "lhs": "tauc",
          "rhs": {
            "op": "ifelse",
            "args": [
              { "op": "==", "args": ["mask", 0] },
              "high_tauc",
              { "op": "mohr_coulomb_yield_stress",
                "args": ["N_till", "phi_deg", "till_cohesion"] }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "tauc_map_cell_15_15",
          "description": "MohrCoulombYieldStress tauc map cell (i=15, j=15) on the test-F exact geometry: H=2999.9999752362119 m, W_till=3.5555555555555559e-12 m, phi=29.999999999912269 deg, mask=2 (grounded dome cell); tauc = c0 + tan(phi) N_till with N_till = P (W ~ 0, saturated) (stage1/dumps/basal_strength/tauc_map.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
