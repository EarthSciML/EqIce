          "id": "plastic_tuple_8",
          "description": "Plastic drag at tauc=200000 Pa, vx=0.0001 m/s, vy=0 m/s: fast sliding limit |tau_b| -> tauc (stage1/dumps/basal_strength/drag_plastic.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
