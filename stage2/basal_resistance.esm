    "ConstantYieldStress": {
      "variables": {
        "constant_value": {
          "type": "parameter",
          "units": "Pa",
          "default": 200000.0,
          "description": "fill value for the constant yield stress (basal_yield_stress.constant.value)"
        },
        "tauc": {
          "type": "unknown",
          "units": "Pa",
          "description": "constant basal yield stress"
        }
      },
      "equations": [
        {
          "_comment": "ConstantYieldStress: tauc is the configured constant value (update_impl is empty; init/regrid fills basal_yield_stress with basal_yield_stress.constant.value).",
          "lhs": "tauc",
          "rhs": "constant_value"
        }
      ],
      "tests": [
        {
          "id": "constant_value",
          "description": "Constant yield stress model: tauc = basal_yield_stress.constant.value = 2e5 Pa for any inputs (ConstantYieldStress.cc; config-derived, not from a Stage-1 dump).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "assertions": [
            { "variable": "tauc", "time": 0.0, "expected": 200000, "tolerance": { "rel": 1e-12 } }
          ]
        }
      ]
    },
    "BasalResistancePlastic": {
      "expression_template_imports": [
        {
          "ref": "./basal_templates.esm"
        }
      ],
      "variables": {
        "tauc": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "yield stress (from the yield-stress model)"
        },
        "vx": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "horizontal ice velocity x-component at the bed"
        },
        "vy": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "horizontal ice velocity y-component at the bed"
        },
        "eps": {
          "type": "parameter",
          "units": "m/s",
          "default": 3.168876464081849e-10,
          "description": "Schoof plastic regularization 0.01 m/yr (basal_resistance.plastic.regularization; 0.01 m / 3.15569259747e7 s, the UDUNITS tropical year)"
        },
        "magreg2": {
          "type": "unknown",
          "units": "m^2/s^2",
          "description": "regularized squared sliding speed eps^2 + vx^2 + vy^2"
        },
        "mag_v": {
          "type": "unknown",
          "units": "m/s",
          "description": "sliding speed |v| = sqrt(vx^2 + vy^2)"
        },
        "beta": {
          "type": "unknown",
          "units": "Pa s/m",
          "description": "drag coefficient beta = tauc/sqrt(eps^2 + v^2); tau_b = -beta v"
        },
        "dbeta": {
          "type": "unknown",
          "units": "Pa s^3/m^3",
          "description": "d(beta)/d(alpha) with alpha = 0.5 |v|^2: -beta/(eps^2 + v^2)"
        },
        "tau_b_mag": {
          "type": "unknown",
          "units": "Pa",
          "description": "basal shear stress magnitude |tau_b| = beta |v|"
        }
      },
      "equations": [
        {
          "_comment": "Regularized squared speed (IceBasalResistancePlasticLaw::drag).",
          "lhs": "magreg2",
          "rhs": {
            "op": "basal_speed_squared",
            "args": ["eps", "vx", "vy"]
          }
        },
        {
          "_comment": "Sliding speed (the |v| dump column).",
          "lhs": "mag_v",
          "rhs": {
            "op": "sqrt",
            "args": [
              { "op": "+", "args": [ { "op": "^", "args": ["vx", 2] }, { "op": "^", "args": ["vy", 2] } ] }
            ]
          }
        },
        {
          "_comment": "IceBasalResistancePlasticLaw::drag: beta = tauc / sqrt(eps^2 + vx^2 + vy^2) (PISM's default SSA basal sliding law, stress_balance.ssa.basal_drag.law = plastic).",
          "lhs": "beta",
          "rhs": {
            "op": "plastic_drag",
            "args": ["tauc", "eps", "vx", "vy"]
          }
        },
        {
          "_comment": "IceBasalResistancePlasticLaw::drag_with_derivative: dbeta = -beta / (eps^2 + vx^2 + vy^2).",
          "lhs": "dbeta",
          "rhs": {
            "op": "plastic_drag_derivative",
            "args": ["tauc", "eps", "vx", "vy"]
          }
        },
        {
          "_comment": "Basal shear stress magnitude |tau_b| = beta |v| (the |tau_b| dump column).",
          "lhs": "tau_b_mag",
          "rhs": {
            "op": "*",
            "args": ["beta", "mag_v"]
          }
        }
      ],
      "tests": [
        {
          "id": "plastic_tuple_1",
          "description": "Plastic drag at tauc=1000 Pa, vx=0 m/s, vy=0 m/s: beta = tauc/sqrt(eps^2+v^2), dbeta = -beta/(eps^2+v^2) with eps = 0.01 m/yr; the dump dbeta_fd central-difference cross-check agrees to ~1e-10 (stage1/dumps/basal_strength/drag_plastic.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "parameter_overrides": {
            "tauc": 1000,
            "vx": 0,
            "vy": 0
          },
          "assertions": [
            { "variable": "mag_v", "time": 0.0, "expected": 0, "tolerance": { "rel": 1e-12 } },
            { "variable": "beta", "time": 0.0, "expected": 3155692597470, "tolerance": { "rel": 1e-12 } },
            { "variable": "dbeta", "time": 0.0, "expected": -3.1425635813203914e+31, "tolerance": { "rel": 1e-12 } },
            { "variable": "tau_b_mag", "time": 0.0, "expected": 0, "tolerance": { "rel": 1e-12 } }
          ]
        },
        {
          "id": "plastic_tuple_2",
          "description": "Plastic drag at tauc=1000 Pa, vx=1e-08 m/s, vy=0 m/s: beta = tauc/sqrt(eps^2+v^2), dbeta = -beta/(eps^2+v^2) with eps = 0.01 m/yr; the dump dbeta_fd central-difference cross-check agrees to ~1e-10 (stage1/dumps/basal_strength/drag_plastic.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "parameter_overrides": {
            "tauc": 1000,
            "vx": 1e-08,
            "vy": 0
          },
          "assertions": [
