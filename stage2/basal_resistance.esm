{
  "esm": "1.0.0",
  "metadata": {
    "name": "basal_resistance",
    "description": "PISM basal-strength component (stage 2 of the eqice project): the pointwise Mohr-Coulomb till model (MohrCoulombPointwise::effective_pressure / yield_stress / till_friction_angle), the MohrCoulombYieldStress tauc map (update_impl with the ice-free high_tauc branch and P_overburden = rho*g*H), the constant yield-stress model, and the three basal-resistance drag laws selectable through stress_balance.ssa.basal_drag.law (IceBasalResistancePlasticLaw, the PISM default SSA law, with the 0.01 m/yr Schoof regularization; IceBasalResistancePseudoPlasticLaw; IceBasalResistanceRegularizedLaw, the Zoet et al. 2020 regularized Coulomb law) -- each drag law its own model so the SSA component can import the configured one by reference. All shared math is imported by reference from ./basal_templates.esm. Tests assert the instantaneous boundary outputs dumped by the instrumented PISM v2.3.2 run (stage1/dumps/basal_strength/). OptTillphiYieldStress (inverse friction-angle optimization, I) and the SSA consumption of beta are deferred."
  },
  "models": {
    "MohrCoulombPointwise": {
      "expression_template_imports": [
        {
          "ref": "./basal_templates.esm"
        }
      ],
      "variables": {
        "delta": {
          "type": "parameter",
          "units": "1",
          "default": 0.02,
          "description": "fraction of overburden pressure delta (basal_yield_stress.mohr_coulomb.till_effective_fraction_overburden)"
        },
        "P_overburden": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "overburden pressure P_o = rho_ice*g*H"
        },
        "water_thickness": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "till water thickness W_till"
        },
        "phi_deg": {
          "type": "parameter",
          "units": "degrees",
          "default": 30.0,
          "description": "till friction angle phi in degrees"
        },
        "W_till_max": {
          "type": "parameter",
          "units": "m",
          "default": 2.0,
          "description": "maximum till water thickness (hydrology.tillwat_max)"
        },
        "till_cohesion": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "till cohesion c_0 (basal_yield_stress.mohr_coulomb.till_cohesion)"
        },
        "N0": {
          "type": "parameter",
          "units": "Pa",
          "default": 1000.0,
          "description": "reference effective pressure N_0 (basal_yield_stress.mohr_coulomb.till_reference_effective_pressure)"
        },
        "e0": {
          "type": "parameter",
          "units": "1",
          "default": 0.69,
          "description": "reference void ratio e_0 (basal_yield_stress.mohr_coulomb.till_reference_void_ratio)"
        },
        "Cc": {
          "type": "parameter",
          "units": "1",
          "default": 0.12,
          "description": "till compressibility coefficient C_c (basal_yield_stress.mohr_coulomb.till_compressibility_coefficient)"
        },
        "N_interior": {
          "type": "unknown",
          "units": "Pa",
          "description": "un-clamped Tulaczyk effective pressure N0*(delta*P/N0)^s*10^((e0/Cc)*(1-s)), s = W_till/W_till_max"
        },
        "N_till": {
          "type": "unknown",
          "units": "Pa",
          "description": "effective pressure on till N_till = min(P_overburden, N_interior)"
        },
        "tauc": {
          "type": "unknown",
          "units": "Pa",
          "description": "basal yield stress tauc = c0 + tan(phi) N_till"
        },
        "phi_inverse_deg": {
          "type": "unknown",
          "units": "degrees",
          "description": "till friction angle recovered from tauc: (180/pi) atan((tauc - c0)/N_till)"
        }
      },
      "equations": [
        {
          "_comment": "MohrCoulombPointwise::effective_pressure, un-clamped Tulaczyk et al. (2000) formula (the N_interior column of the dump).",
          "lhs": "N_interior",
          "rhs": {
            "op": "mohr_coulomb_N_interior",
            "args": [
              "delta",
              "P_overburden",
              "water_thickness"
            ]
          }
        },
        {
          "_comment": "MohrCoulombPointwise::effective_pressure with the min(P_overburden, .) saturation clamp.",
          "lhs": "N_till",
          "rhs": {
            "op": "mohr_coulomb_effective_pressure",
            "args": [
              "delta",
              "P_overburden",
              "water_thickness"
            ]
          }
        },
        {
          "_comment": "MohrCoulombPointwise::yield_stress: tauc = c0 + tan(phi) N_till.",
          "lhs": "tauc",
          "rhs": {
            "op": "mohr_coulomb_yield_stress",
            "args": [
              "N_till",
              "phi_deg",
              "till_cohesion"
            ]
          }
        },
        {
          "_comment": "MohrCoulombPointwise::till_friction_angle: the inverse of yield_stress; the round trip phi -> tauc -> phi must recover phi.",
          "lhs": "phi_inverse_deg",
          "rhs": {
            "op": "mohr_coulomb_friction_angle",
            "args": [
              "N_till",
              "tauc",
              "till_cohesion"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "yield_stress_tuple_1",
          "description": "Mohr-Coulomb yield stress at delta=0.01, P_overburden=0 Pa, water_thickness=0 m, phi=0 deg (stage1/dumps/basal_strength/yield_stress.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "parameter_overrides": {
            "delta": 0.01,
            "P_overburden": 0,
            "water_thickness": 0,
            "phi_deg": 0
          },
          "assertions": [
            { "variable": "N_till", "time": 0.0, "expected": 0, "tolerance": { "rel": 1e-12 } },
            { "variable": "tauc", "time": 0.0, "expected": 0, "tolerance": { "rel": 1e-12 } }
          ]
        },
        {
          "id": "yield_stress_tuple_2",
          "description": "Mohr-Coulomb yield stress at delta=0.01, P_overburden=0 Pa, water_thickness=0 m, phi=45 deg (stage1/dumps/basal_strength/yield_stress.csv).",
