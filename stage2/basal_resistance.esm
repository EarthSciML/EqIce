            { "variable": "dbeta", "time": 0.0, "expected": -3.1425635813203916e+32, "tolerance": { "rel": 1e-12 } },
            { "variable": "tau_b_mag", "time": 0.0, "expected": 0, "tolerance": { "rel": 1e-12 } }
          ]
        },
        {
          "id": "plastic_tuple_5",
          "description": "Plastic drag at tauc=100000 Pa, vx=1e-07 m/s, vy=0 m/s: beta = tauc/sqrt(eps^2+v^2), dbeta = -beta/(eps^2+v^2) with eps = 0.01 m/yr; the dump dbeta_fd central-difference cross-check agrees to ~1e-10 (stage1/dumps/basal_strength/drag_plastic.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "parameter_overrides": {
