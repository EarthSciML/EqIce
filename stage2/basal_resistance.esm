            { "variable": "dbeta", "time": 0.0, "expected": -9.9849562178026922e+26, "tolerance": { "rel": 1e-12 } },
            { "variable": "tau_b_mag", "time": 0.0, "expected": 999.49828892151277, "tolerance": { "rel": 1e-12 } }
          ]
        },
        {
          "id": "plastic_tuple_3",
          "description": "Plastic drag at tauc=1000 Pa, vx=0 m/s, vy=3.1689e-06 m/s: beta = tauc/sqrt(eps^2+v^2), dbeta = -beta/(eps^2+v^2) with eps = 0.01 m/yr; the dump dbeta_fd central-difference cross-check agrees to ~1e-10 (stage1/dumps/basal_strength/drag_plastic.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "parameter_overrides": {
            "tauc": 1000,
            "vx": 0,
            "vy": 3.1689e-06
          },
          "assertions": [
