      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":2999.999975236212,"bed_m":-1509.4947867712904},
      "assertions": [
        { "variable": "shelf_base_temperature", "time": 0.0, "expected": 271.0342773174644, "tolerance": { "rel": 1e-12 } },
        { "variable": "shelf_base_mass_flux", "time": 0.0, "expected": 1.3638023070030661e-05, "tolerance": { "rel": 1e-12 } },
        { "variable": "average_water_column_pressure", "time": 0.0, "expected": 3829782.4986988152, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "map_ice_free_cell_0_0",
      "description": "PIK ocean map at the ice-free cell (i,j)=(0,0) of the test-F run (H=0 m, bed=-1500.0003475867986 m, sea level 0): shelf_base_temperature = T0, shelf_base_mass_flux = the H=0 value Q/L (the C++ computes it everywhere, ice or not), average_water_column_pressure = 0 (stage1/dumps/surface_ocean/columns.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":0.0,"bed_m":-1500.0003475867986},
      "assertions": [
        { "variable": "shelf_base_temperature", "time": 0.0, "expected": 273.15, "tolerance": { "rel": 1e-12 } },
        { "variable": "shelf_base_mass_flux", "time": 0.0, "expected": 1.2298625736526746e-06, "tolerance": { "rel": 1e-12 } },
        { "variable": "average_water_column_pressure", "time": 0.0, "expected": 0.0, "tolerance": { "rel": 1e-12 } }
      ]
    }
      ]
    },
    "OceanConstant": {
      "expression_template_imports": [
        {
          "ref": "./surface_forcing_templates.esm"
        }
      ],
      "variables": {
        "H_m": {
          "type": "parameter",
          "units": "m",
          "default": 2999.9999752362119,
          "description": "ice thickness (geometry.ice_thickness); the dome cell value"
        },
        "bed_m": {
          "type": "parameter",
          "units": "m",
          "default": -1509.4947867712904,
          "description": "bed elevation (geometry.bed_elevation); the dome cell value"
        },
        "z_s_m": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "sea level elevation (geometry.sea_level_elevation)"
        },
        "melt_rate_m_per_s": {
          "type": "parameter",
          "units": "m/s",
          "default": 1.6450966622180257e-09,
          "description": "constant-ocean melt rate ocean.constant.melt_rate = 0.051914193590840291 m/yr converted to m/s"
        },
        "T0": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point (constants.fresh_water.melting_point_temperature)"
        },
        "beta_CC": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "rho_i": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_w": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1028.0,
          "description": "sea water density (constants.sea_water.density)"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "standard gravity (constants.standard_gravity)"
        },
        "shelf_base_temperature": {
          "type": "unknown",
          "units": "K",
          "description": "shelf base temperature = the same pressure melting point as the PIK ocean (ocean::Constant::update_impl calls melting_point_temperature)"
        },
        "shelf_base_mass_flux": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "shelf base mass flux = melt_rate*rho_i, uniform over the domain (ocean::Constant::update_impl)"
        },
        "ice_bottom": {
          "type": "unknown",
          "units": "m",
          "description": "ice bottom elevation max(bed, z_s - rho_i/rho_w*H) (pism::average_water_column_pressure)"
        },
        "water_column_height": {
          "type": "unknown",
          "units": "m",
          "description": "water column height max(z_s - ice_bottom, 0) (pism::average_water_column_pressure)"
        },
        "average_water_column_pressure": {
          "type": "unknown",
          "units": "Pa",
          "description": "depth-averaged water column pressure 0.5*rho_w*g*h_w^2/H (identical to the PIK ocean; pism::average_water_column_pressure)"
        }
      },
      "equations": [
        {
          "_comment": "ocean::Constant::update_impl: shelf_base_temperature = the linear pressure melting point (identical to ocean::PIK).",
          "lhs": "shelf_base_temperature",
          "rhs": {
            "op": "shelf_base_temperature",
            "args": ["H_m"]
          }
        },
        {
          "_comment": "ocean::Constant::update_impl: shelf_base_mass_flux = melt_rate*rho_i, uniform (0.051914 m/yr ice-equivalent in the reference run).",
          "lhs": "shelf_base_mass_flux",
          "rhs": {
            "op": "constant_ocean_mass_flux",
            "args": ["melt_rate_m_per_s"]
          }
        },
        {
          "_comment": "pism::average_water_column_pressure: ice_bottom = max(bed, z_s - rho_i/rho_w*H).",
          "lhs": "ice_bottom",
          "rhs": {
            "op": "ice_bottom_elevation",
            "args": ["H_m", "bed_m", "z_s_m"]
          }
        },
        {
          "_comment": "pism::average_water_column_pressure: h_w = max(z_s - ice_bottom, 0).",
          "lhs": "water_column_height",
          "rhs": {
            "op": "water_column_height",
            "args": ["z_s_m", "ice_bottom"]
          }
        },
        {
          "_comment": "pism::average_water_column_pressure: P = 0.5*rho_w*g*h_w^2/H (identical to the PIK ocean).",
          "lhs": "average_water_column_pressure",
          "rhs": {
            "op": "average_water_column_pressure",
            "args": ["H_m", "water_column_height"]
          }
        }
      ],
      "tests": [
    {
      "id": "constant_ocean_uniform_mass_flux_dome",
      "description": "Constant ocean: shelf_base_mass_flux = melt_rate*rho_i = 0.051914193590840291 m/yr (converted to m/s) * 910 kg m^-3 = 1.4970379626184034e-06 kg m^-2 s^-1, uniform over the domain -- asserted at the dome cell (ocean::Constant::update_impl; stage1/dumps/surface_ocean/columns.csv shelfbmassflux_const).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":2999.999975236212,"bed_m":-1509.4947867712904},
      "assertions": [
        { "variable": "shelf_base_mass_flux", "time": 0.0, "expected": 1.4970379626184034e-06, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "constant_ocean_uniform_mass_flux_ice_free",
      "description": "Constant ocean: the uniform shelf_base_mass_flux holds in ice-free cells too (H=0, the (0,0) cell) (stage1/dumps/surface_ocean/columns.csv shelfbmassflux_const).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":0.0,"bed_m":-1500.0003475867986},
      "assertions": [
        { "variable": "shelf_base_mass_flux", "time": 0.0, "expected": 1.4970379626184034e-06, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
