      "description": "Constant ocean map at the dome cell (i,j)=(15,15): shelf_base_temperature and average_water_column_pressure are identical to the PIK ocean (both call the same melting_point_temperature and compute_average_water_column_pressure helpers); asserted against the dump's shelfbtemp_const and awcp_const columns (stage1/dumps/surface_ocean/columns.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":2999.999975236212,"bed_m":-1509.4947867712904},
      "assertions": [
        { "variable": "shelf_base_temperature", "time": 0.0, "expected": 271.0342773174644, "tolerance": { "rel": 1e-12 } },
        { "variable": "average_water_column_pressure", "time": 0.0, "expected": 3829782.4986988152, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "constant_ocean_ice_free_cell_0_0",
      "description": "Constant ocean map at the ice-free cell (i,j)=(0,0): shelf_base_temperature = T0 and average_water_column_pressure = 0 (H=0) (stage1/dumps/surface_ocean/columns.csv shelfbtemp_const / awcp_const).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":0.0,"bed_m":-1500.0003475867986},
      "assertions": [
