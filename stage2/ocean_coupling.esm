{
  "esm": "1.0.0",
  "metadata": {
    "name": "ocean_coupling",
    "description": "PISM ocean-coupling component (stage 2 of the eqice project): the PIK ocean (ocean::PIK, the Beckmann-Goosse-style sub-shelf parameterization of Martin et al. 2011 -- shelf_base_temperature = the linear pressure melting point T0 - beta_CC*rho_i*g*H, the shelf_base_mass_flux chain z_b -> T_f -> Q -> Q/L with z_b = -(rho_i/rho_w)*H, T_f = 273.15 + (0.0939 - 0.057*S + 7.64e-4*z_b) and Q = melt_factor*rho_w*c_p_ocean*gamma_T*(T_ocean - T_f), positive = melting) and the average_water_column_pressure integral at a margin (ice_bottom = max(bed, z_s - rho_i/rho_w*H), h_w = max(z_s - ice_bottom, 0), P = 0.5*rho_w*g*h_w^2/H for H > 0, else 0), plus the Constant ocean cross-check (ocean::Constant: the same pressure melting point and water column pressure, with a uniform shelf_base_mass_flux = melt_rate*rho_i). All shared math is imported by reference from ./surface_forcing_templates.esm. Tests assert the instantaneous boundary outputs dumped by the instrumented PISM v2.3.2 run (stage1/dumps/surface_ocean/). Deferred: PICO, the holland_jenkins / thin-film (GivenTH) parameterizations, the delta_T / delta_SMB / delta_MBP / frac_MBP / frac_SMB / anomaly modifiers, runoff_to_ocean_melt, ocean.sub_shelf_heat_flux_into_ice, sea-level coupling, and frontal-melt physics."
  },
  "models": {
    "OceanPIK": {
      "expression_template_imports": [
        {
          "ref": "./surface_forcing_templates.esm"
        }
      ],
      "variables": {
        "H_m": {
          "type": "parameter",
          "units": "m",
          "default": 2999.9999752362119,
          "description": "ice thickness (geometry.ice_thickness); the dome cell value"
        },
        "bed_m": {
          "type": "parameter",
          "units": "m",
          "default": -1509.4947867712904,
          "description": "bed elevation (geometry.bed_elevation); the dome cell value"
        },
        "z_s_m": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "sea level elevation (geometry.sea_level_elevation)"
        },
        "T_ocean_K": {
          "type": "parameter",
          "units": "K",
          "default": 271.45,
          "description": "ocean temperature T_ocean = -1.7 deg C (hard-coded default in ConstantPIK.cc)"
        },
        "salinity": {
          "type": "parameter",
          "units": "g/kg",
          "default": 35.0,
          "description": "ocean salinity, g/kg (hard-coded in ConstantPIK.cc)"
        },
        "T0": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point (constants.fresh_water.melting_point_temperature)"
        },
        "beta_CC": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "rho_i": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_w": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1028.0,
          "description": "sea water density (constants.sea_water.density)"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "standard gravity (constants.standard_gravity)"
        },
        "melt_factor": {
          "type": "parameter",
          "units": "1",
          "default": 0.005,
          "description": "ocean.pik_melt_factor"
        },
        "c_p_ocean": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 3974.0,
          "description": "specific heat capacity of the ocean mixed layer (hard-coded 3974 J/(K kg) in ConstantPIK.cc)"
        },
        "gamma_T": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0001,
          "description": "thermal exchange velocity (hard-coded 1e-4 m/s in ConstantPIK.cc)"
        },
        "L": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "shelf_base_temperature": {
          "type": "unknown",
          "units": "K",
          "description": "shelf base temperature = linear pressure melting point T0 - beta_CC*rho_i*g*H (ocean::PIK::melting_point_temperature; DEcreases with ice thickness)"
        },
        "shelf_base_elevation": {
          "type": "unknown",
          "units": "m",
          "description": "shelf base elevation z_b = -(rho_i/rho_w)*H (ocean::PIK::mass_flux)"
        },
        "freezing_temperature": {
          "type": "unknown",
          "units": "K",
          "description": "freezing temperature of ocean water under the shelf T_f = 273.15 + (0.0939 - 0.057*S + 7.64e-4*z_b) (Beckmann & Goosse 2003 eq. 2)"
        },
        "ocean_heat_flux": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "ocean-to-ice heat flux Q = melt_factor*rho_w*c_p_ocean*gamma_T*(T_ocean - T_f); positive when T_ocean > T_f (melting)"
        },
        "shelf_base_mass_flux": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "shelf base mass flux = Q/L (positive = melting; the geometry update has dH_BMB = -dt*mf/rho_i)"
        },
        "ice_bottom": {
          "type": "unknown",
          "units": "m",
          "description": "ice bottom elevation ice_bottom = max(bed, z_s - rho_i/rho_w*H) (pism::average_water_column_pressure)"
        },
        "water_column_height": {
          "type": "unknown",
          "units": "m",
          "description": "water column height h_w = max(z_s - ice_bottom, 0) (pism::average_water_column_pressure)"
        },
        "average_water_column_pressure": {
          "type": "unknown",
          "units": "Pa",
          "description": "vertically-averaged water column pressure over an ice cliff at a margin P = 0.5*rho_w*g*h_w^2/H for H > 0, else 0 (pism::average_water_column_pressure)"
        }
      },
      "equations": [
        {
          "_comment": "ocean::PIK::melting_point_temperature: T_shelf = T0 - beta_CC*rho_i*g*H, the linear pressure melting point (identical in ocean::Constant).",
          "lhs": "shelf_base_temperature",
          "rhs": {
            "op": "shelf_base_temperature",
            "args": ["H_m"]
          }
        },
        {
          "_comment": "ocean::PIK::mass_flux, first step: the shelf base elevation z_b = -(rho_i/rho_w)*H.",
          "lhs": "shelf_base_elevation",
          "rhs": {
            "op": "shelf_base_elevation",
            "args": ["H_m"]
          }
        },
        {
          "_comment": "ocean::PIK::mass_flux: the freezing temperature T_f = 273.15 + (0.0939 - 0.057*S + 7.64e-4*z_b) (Beckmann & Goosse 2003 eq. 2).",
          "lhs": "freezing_temperature",
          "rhs": {
            "op": "beckmann_goosse_freezing_temperature",
            "args": ["shelf_base_elevation"]
          }
        },
        {
          "_comment": "ocean::PIK::mass_flux: the ocean-to-ice heat flux Q = melt_factor*rho_w*c_p_ocean*gamma_T*(T_ocean - T_f) in W/m^2.",
          "lhs": "ocean_heat_flux",
          "rhs": {
            "op": "ocean_to_ice_heat_flux",
            "args": ["T_ocean_K", "freezing_temperature"]
          }
        },
        {
          "_comment": "ocean::PIK::mass_flux: mass_flux = Q/L (the C++ divides by L*ice_density and multiplies by ice_density, net Q/L); positive = melting.",
          "lhs": "shelf_base_mass_flux",
          "rhs": {
            "op": "shelf_base_mass_flux",
            "args": ["ocean_heat_flux"]
          }
        },
        {
          "_comment": "pism::average_water_column_pressure: ice_bottom = max(bed, z_s - rho_i/rho_w*H) (the floatation level for floating ice, the bed for grounded ice).",
          "lhs": "ice_bottom",
          "rhs": {
            "op": "ice_bottom_elevation",
            "args": ["H_m", "bed_m", "z_s_m"]
          }
        },
        {
          "_comment": "pism::average_water_column_pressure: h_w = max(z_s - ice_bottom, 0).",
          "lhs": "water_column_height",
          "rhs": {
            "op": "water_column_height",
            "args": ["z_s_m", "ice_bottom"]
          }
        },
        {
          "_comment": "pism::average_water_column_pressure: P = 0.5*rho_w*g*h_w^2/H for H > 0, else 0 (the depth-averaged form, NOT rho_w*g*h_w).",
          "lhs": "average_water_column_pressure",
          "rhs": {
            "op": "average_water_column_pressure",
            "args": ["H_m", "water_column_height"]
          }
        }
      ],
      "tests": [
    {
      "id": "tshelf_H_0",
      "description": "PIK ocean pressure melting point at ice thickness H=0 m: T_shelf = T0 - beta_CC*rho_i*g*H = 273.14999999999998 K, decreasing with depth (ocean::PIK::melting_point_temperature, identical in ocean::Constant) (stage1/dumps/surface_ocean/shelf_base_temperature.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":0.0},
      "assertions": [
        { "variable": "shelf_base_temperature", "time": 0.0, "expected": 273.15, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "tshelf_H_100",
      "description": "PIK ocean pressure melting point at ice thickness H=100 m: T_shelf = T0 - beta_CC*rho_i*g*H = 273.07947590999999 K, decreasing with depth (ocean::PIK::melting_point_temperature, identical in ocean::Constant) (stage1/dumps/surface_ocean/shelf_base_temperature.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"H_m":100.0},
      "assertions": [
        { "variable": "shelf_base_temperature", "time": 0.0, "expected": 273.07947591, "tolerance": { "rel": 1e-12 } }
      ]
