{
 "esm": "1.1.0",
 "metadata": {
  "name": "ice_energy",
  "description": "PISM enthalpy (energy) component (stage 2 of the eqice project): the EnthalpyModel column solve -- vertical enthalpy diffusion D(K*D(E,z),z) and vertical advection with the BOMBPROOF column stencil of enthSystemCtx, explicit horizontal enthalpy advection with first-order upwinding, strain heating, the surface Dirichlet row (E_surface = Enth_ks), the cold/temperate thermal-diffusivity switch (with the C++ basal R[0]-from-Enth[1] special case), the coarse/fine-grid interpolation maps of ColumnInterpolation.cc, the drainage-rate curve of DrainageCalculator.hh (via the templates; the post-solve drainage/bulge-limit post-processing is deferred), and the basal melt rate of EnthalpyModel::basal_melt_rate. All shared math is imported by reference from ./energy_templates.esm and ./ice_rheology_templates.esm. The state is the fine-grid enthalpy E_f; the model reproduces the one-step solve of the instrumented PISM v2.3.2 run (stage1/dumps/energy/) as an accurate integration of the semi-discrete operator dE/dt = f(E): the harness cannot force PISM's single backward-Euler step, so assertions use the measured integration-scheme gap (<= ~35 J/kg at the dome base, <= ~1.5 J/kg elsewhere; see PROGRESS.md). The full 31x31 3-D coupled field, the warm/floating basal branches, the CHSystem, TemperatureModel, and BedThermalUnit are deferred (documented in PROGRESS.md)."
 },
 "solver": {
  "stiffness": "high",
  "reltol": 1e-08,
  "abstol": 0.01
 },
 "models": {
  "EnthalpyColumn": {
   "expression_template_imports": [
    {
     "ref": "./energy_templates.esm"
    },
    {
     "ref": "./ice_rheology_templates.esm"
    }
   ],
   "variables": {
    "E_f": {
     "type": "unknown",
     "units": "J/kg",
     "shape": [
      "lev_f"
     ],
     "description": "Fine-grid enthalpy (the PISM enthalpy solve state)."
    },
    "K": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "lev_f"
     ],
     "description": "Effective thermal diffusivity k/(rho*c) (ratio*k/(rho*c) for temperate ice), assembled once from the INITIAL enthalpy exactly as enthSystemCtx::assemble_R; the basal entry K[1] switches on the level-2 state (the C++ R[0] special case)."
    },
    "w_eff": {
     "type": "unknown",
     "units": "m/s",
     "shape": [
      "lev_f"
     ],
     "description": "Vertical velocity after the marginal gate (enthSystemCtx::init zeroes m_w for marginal columns when energy.margin_exclude_vertical_advection is set)."
    },
    "diffusion_term": {
     "type": "unknown",
     "units": "J/(kg s)",
     "shape": [
      "lev_f"
     ],
     "description": "Vertical enthalpy diffusion D(K*D(E_f,z),z) with the BOMBPROOF column stencil."
    },
    "adv_term": {
     "type": "unknown",
     "units": "J/(kg s)",
     "shape": [
      "lev_f"
     ],
     "description": "Vertical enthalpy advection stencil as it appears in the C++ tridiagonal (D = I - dt*M); its ODE contribution is the negative (physical -w*dE/dz)."
    },
    "hadv_term": {
     "type": "unknown",
     "units": "J/(kg s)",
     "shape": [
      "lev_f"
     ],
     "description": "Explicit horizontal enthalpy advection with first-order upwinding, evaluated at the FROZEN initial enthalpy (PISM's explicit B-array treatment)."
    },
    "strain_term": {
     "type": "unknown",
     "units": "J/(kg s)",
     "shape": [
      "lev_f"
     ],
     "description": "Strain heating sigma/rho on rows 1..ks (excluded at marginal columns when energy.margin_exclude_strain_heating is set)."
    },
    "E_out": {
     "type": "unknown",
     "units": "J/kg",
     "shape": [
      "lev"
     ],
     "description": "Storage-grid output enthalpy (fine_to_coarse of E_f), the quantity the Stage-1 dumps carry."
    },
    "p_base": {
     "type": "unknown",
     "units": "Pa",
     "description": "Ice pressure at the base (p_air = 0)."
    },
    "p_up": {
     "type": "unknown",
     "units": "Pa",
     "description": "Ice pressure one fine level above the base."
    },
    "Tpmp_base": {
     "type": "unknown",
     "units": "K",
     "description": "Pressure melting point at the base."
    },
    "Tpmp_up": {
     "type": "unknown",
     "units": "K",
     "description": "Pressure melting point one fine level above the base."
    },
    "cts_base": {
     "type": "unknown",
     "units": "J/kg",
     "description": "Cold-temperate transition enthalpy at the base."
    },
    "cts_up": {
     "type": "unknown",
     "units": "J/kg",
     "description": "Cold-temperate transition enthalpy one fine level above the base."
    },
    "base_temperate": {
     "type": "unknown",
     "units": "1",
     "description": "True when the base is temperate (E_f[1] >= cts_base), the till_water == 0 branch of EnthalpyModel::basal_melt_rate."
    },
    "k1_temperate": {
     "type": "unknown",
     "units": "1",
     "description": "True when fine level 2 is temperate (the branch selecting the T-gradient heat flux in basal_melt_rate)."
    },
    "hf_up": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Upward conductive heat flux at the base: -k*(T_pmp gradient) if level 2 is temperate, else -K_0*(E[2]-E[1])/dz."
    },
    "bmelt": {
     "type": "unknown",
     "units": "m/s",
     "description": "Basal melt rate (EnthalpyModel::basal_melt_rate): 0 for a cold base, else (G_geo - hf_up)/(rho_ice*L(T_pmp)), floor 0."
    },
    "H": {
     "type": "parameter",
     "units": "m",
     "default": 2999.999975236212,
     "description": "Ice thickness."
    },
    "ks": {
     "type": "parameter",
     "units": "1",
     "default": 45.0,
     "description": "Fine-grid top-of-ice level, 0-based (floor(H/dz_f))."
    },
    "dz": {
     "type": "parameter",
     "units": "m",
     "default": 65.57377049180327,
     "description": "Fine-grid spacing (4000/61 m, ColumnInterpolation::init_fine_grid)."
    },
    "dx": {
     "type": "parameter",
     "units": "m",
     "default": 58064.516129,
     "description": "Horizontal grid spacing (Lx/31)."
    },
    "G": {
     "type": "parameter",
     "units": "J/(kg m)",
     "default": -40.18,
     "description": "Basal enthalpy-flux gradient G = -q_geo/(rho_ice*dz^2*R[0]/dt) = -q_geo*c_ice/k_ice (set_basal_heat_flux), J/(kg m)."
    },
    "lambda": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "BOMBPROOF parameter (1 for cold columns; 0 if temperate ice present)."
    },
    "Enth_ks": {
     "type": "parameter",
     "units": "J/kg",
     "default": 0.03355030000665238,
     "description": "Surface Dirichlet enthalpy E_permissive(T_s, omega=0, p_surface)."
    },
    "marginal": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Marginal-column flag (1 when any 8-neighbor is thinner than 100 m)."
    },
    "exclude_v_adv": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "energy.margin_exclude_vertical_advection (yes)."
    },
    "exclude_h_adv": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "energy.margin_exclude_horizontal_advection (yes)."
    },
    "exclude_strain_heat": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "energy.margin_exclude_strain_heating (yes)."
    },
    "rho_ice": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 910.0,
     "description": "Ice density."
    },
    "c_ice": {
     "type": "parameter",
     "units": "J/(kg K)",
     "default": 2009.0,
     "description": "Specific heat capacity of ice."
    },
    "k_ice": {
     "type": "parameter",
     "units": "W/(m K)",
     "default": 2.1,
     "description": "Thermal conductivity of ice."
    },
    "ratio": {
     "type": "parameter",
     "units": "1",
     "default": 0.1,
     "description": "energy.enthalpy.temperate_ice_thermal_conductivity_ratio."
    },
    "g": {
     "type": "parameter",
     "units": "m/s^2",
     "default": 9.81,
     "description": "Standard gravity."
    },
    "T_melting": {
     "type": "parameter",
     "units": "K",
     "default": 273.15,
     "description": "Fresh-water melting point."
    },
    "T_0": {
     "type": "parameter",
     "units": "K",
     "default": 223.15,
     "description": "Reference temperature (enthalpy_converter.T_reference)."
    },
    "beta_Clausius_Clapeyron": {
     "type": "parameter",
     "units": "K/Pa",
     "default": 7.9e-08,
     "description": "Clausius-Clapeyron gradient."
    },
    "L_0": {
     "type": "parameter",
     "units": "J/kg",
     "default": 334000.0,
     "description": "Latent heat of fusion at 273.15 K."
    },
    "c_water": {
     "type": "parameter",
     "units": "J/(kg K)",
     "default": 4170.0,
     "description": "Specific heat capacity of liquid water."
    },
    "OM1": {
     "type": "parameter",
     "units": "1",
     "default": 0.01,
     "description": "energy.drainage_target_water_fraction."
    },
    "DR3": {
     "type": "parameter",
     "units": "1/s",
     "default": 1.58443823077064e-09,
     "description": "energy.drainage_maximum_rate (0.05/yr)."
    },
    "Ggeo": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.042,
     "description": "Basal geothermal flux (test-F G_geo), W/m^2."
    },
