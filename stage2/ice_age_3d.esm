              "op": "ifelse",
              "args": [
                {
                  "op": ">",
                  "args": [
                    "k",
                    {
                      "op": "index",
                      "args": [
                        "ks_b",
                        "i",
                        "j"
                      ]
                    }
                  ]
                },
                0.0,
                {
                  "op": "ifelse",
                  "args": [
                    {
                      "op": "==",
                      "args": [
                        "k",
                        {
                          "op": "index",
                          "args": [
                            "ks_b",
                            "i",
                            "j"
