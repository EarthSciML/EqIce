    "PointwiseIsostasyUpdate": {
      "expression_template_imports": [
        {
          "ref": "./bed_templates.esm"
        }
      ],
      "variables": {
        "load": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "the time-averaged load fed to update_impl (ice-equivalent m)"
        },
        "bed_in": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "bed elevation at the start of the update interval (m_topg_last)"
        },
        "load_last": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at the time of the previous update (m_load_last; initialized to the initial load by init_impl)"
        },
        "rho_ice": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density, the 'load density' of PointwiseIsostasy::update_impl)"
        },
        "rho_mantle": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 3300.0,
          "description": "mantle density (bed_deformation.mantle_density)"
        },
        "f": {
          "type": "unknown",
          "units": "1",
          "description": "isostatic compensation factor rho_ice/rho_mantle"
        },
        "bed_out": {
          "type": "unknown",
          "units": "m",
          "description": "bed elevation after the update: topg_{n+1} = topg_last - f*(load - load_last)"
        },
        "new_load_last": {
          "type": "unknown",
          "units": "m",
          "description": "load_last after the update: load_last <- load (PointwiseIsostasy has no relaxation time)"
        }
      },
      "equations": [
        {
          "_comment": "PointwiseIsostasy::update_impl: f = rho_ice/rho_mantle.",
          "lhs": "f",
          "rhs": {
            "op": "isostatic_compensation_factor",
            "args": [
              "rho_ice",
              "rho_mantle"
            ]
          }
        },
        {
          "_comment": "PointwiseIsostasy::update_impl: topg = topg_last - f*(load - load_last).",
          "lhs": "bed_out",
          "rhs": {
            "op": "isostatic_bed_update",
            "args": [
              "bed_in",
              "load",
              "load_last",
              "rho_ice",
              "rho_mantle"
            ]
          }
        },
        {
          "_comment": "PointwiseIsostasy::update_impl: load_last <- load.",
          "lhs": "new_load_last",
          "rhs": "load"
        }
      ],
      "tests": [
        {
          "id": "update_law_tuple_1",
