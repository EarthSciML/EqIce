    "BedDefLoadAccumulator": {
      "variables": {
        "load_1": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at call 1 of the update interval (ice-equivalent m; the driver's per-call load)"
        },
        "load_2": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at call 2 of the update interval"
        },
        "load_3": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at call 3 of the update interval"
        },
        "load_4": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at call 4 of the update interval"
        },
        "load_5": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at call 5 of the update interval"
        },
        "dt_call": {
          "type": "parameter",
          "units": "s",
          "default": 630720000.0,
          "description": "driver call length (20 '365day years' = interval/5 in the stage1/dumps/bed run; 1 yr365 = 31536000 s)"
        },
        "dt_beddef": {
          "type": "parameter",
          "units": "s",
          "default": 3153600000.0,
          "description": "length of the update interval dt_beddef = t_final - m_t_last (100 '365day years'; the divisor of the load accumulator)"
        },
        "load_accumulator": {
          "type": "unknown",
          "units": "m s",
          "description": "time-integrated load over the update interval, sum of load_k*dt_call over the calls that tile it (the C++ m_load_accumulator; the exact evaluation of the interval integral of the piecewise-constant load history)"
        },
        "load_avg": {
          "type": "unknown",
          "units": "m",
          "description": "time-averaged load fed to update_impl: load_accumulator/dt_beddef (the C++ m_load = m_load_accumulator scaled by 1/dt_beddef)"
        }
      },
      "equations": [
        {
          "_comment": "BedDef::update accumulate_load: the load accumulator is the time integral of the load over the update interval; for the piecewise-constant driver history (5 calls of length dt_call per interval, load_history.csv) this is the exact sum load_1*dt_call + ... + load_5*dt_call (the C++ m_load_accumulator.add(1.0, m_load, dt) per call).",
          "lhs": "load_accumulator",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "load_1",
                  "dt_call"
                ]
              },
              {
                "op": "*",
                "args": [
                  "load_2",
                  "dt_call"
                ]
              },
              {
                "op": "*",
                "args": [
                  "load_3",
                  "dt_call"
                ]
              },
              {
                "op": "*",
                "args": [
                  "load_4",
                  "dt_call"
                ]
              },
              {
                "op": "*",
                "args": [
                  "load_5",
                  "dt_call"
                ]
              }
            ]
          }
        },
        {
          "_comment": "BedDef::update at the update time: the time-averaged load is the accumulator divided by dt_beddef = t_final - m_t_last (the C++ computes m_load.scale(1.0/dt_beddef) -- a multiply by the reciprocal; the difference from division is at the 1-ulp level).",
          "lhs": "load_avg",
          "rhs": {
            "op": "/",
            "args": [
              "load_accumulator",
              "dt_beddef"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "accumulator_dome_interval_1",
          "description": "Interval-1 load accumulator at the dome cell (15,15), H0 = 2999.9999752362119 m: the five 20-yr calls carry loads H0 + {0,75,150,225,300} m (load_history.csv), so load_accumulator = sum(load_k*dt_call) and load_avg = load_accumulator/dt_beddef with dt_beddef = 5*dt_call = 100 '365day years' (the accumulator divide-by-dt_beddef subtlety: the time average of the ramp is exactly H0 + dH/2); the time-averaged load fed to update_impl is H0 + 150 m = 3149.9999752362119 m (columns.csv load_avg).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "load_1": 2999.999975236212,
            "load_2": 3074.999975236212,
            "load_3": 3149.999975236212,
            "load_4": 3224.999975236212,
            "load_5": 3299.999975236212,
            "dt_call": 630720000.0,
            "dt_beddef": 3153600000.0
          },
          "assertions": [
            {
              "variable": "load_avg",
              "time": 0.0,
              "expected": 3149.999975236212,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "accumulator_margin_interval_1",
          "description": "Interval-1 load accumulator at the near-margin cell (5,7), H0 = 321.79367040294261 m (the smallest grounded ice thickness; FP round-off in the accumulator makes the dump's average differ from H0+150 by ~6e-14 m, reproduced here); the time-averaged load fed to update_impl is the dump's load_avg_1 = 471.79367040294255 m = 471.79367040294255 m (columns.csv load_avg).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "load_1": 321.7936704029426,
            "load_2": 396.7936704029426,
            "load_3": 471.7936704029426,
            "load_4": 546.7936704029426,
            "load_5": 621.7936704029426,
            "dt_call": 630720000.0,
            "dt_beddef": 3153600000.0
          },
          "assertions": [
            {
              "variable": "load_avg",
              "time": 0.0,
              "expected": 471.79367040294255,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "accumulator_dome_interval_2",
          "description": "Interval-2 load accumulator at the dome cell (15,15): the load is constant at H0 + 300 m over all five 20-yr calls, so the time average is the constant load itself; the time-averaged load fed to update_impl is H0 + 300 m = 3299.9999752362119 m (columns.csv load_avg).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "load_1": 3299.999975236212,
            "load_2": 3299.999975236212,
            "load_3": 3299.999975236212,
            "load_4": 3299.999975236212,
            "load_5": 3299.999975236212,
            "dt_call": 630720000.0,
            "dt_beddef": 3153600000.0
          },
          "assertions": [
            {
              "variable": "load_avg",
              "time": 0.0,
              "expected": 3299.999975236212,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "accumulator_farfield",
          "description": "Load accumulator on an ice-free far-field cell (0,0): every call carries load 0 (the driver passes H = 0 off the ice), so the average is exactly 0 and no compensation ever occurs; the time-averaged load fed to update_impl is 0 m = 0 m (columns.csv load_avg).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "load_1": 0.0,
            "load_2": 0.0,
            "load_3": 0.0,
            "load_4": 0.0,
            "load_5": 0.0,
            "dt_call": 630720000.0,
            "dt_beddef": 3153600000.0
          },
          "assertions": [
            {
              "variable": "load_avg",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        }
      ]
    },
    "PointwiseIsostasyTwoIntervals": {
      "expression_template_imports": [
        {
          "ref": "./bed_templates.esm"
        }
      ],
      "variables": {
        "bed_in_1": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "bed elevation at the start of interval 1 (the initial flat bed, topg_last before the first update)"
        },
        "load_last_0": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "load at the time of the previous update before interval 1 (m_load_last from init_impl: the load of the initial geometry -- H0 on grounded ice cells)"
        },
        "load_avg_1": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "time-averaged load over interval 1 (H0 + 150 m in the stage1/dumps/bed run)"
        },
        "load_avg_2": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "time-averaged load over interval 2 (H0 + 300 m in the stage1/dumps/bed run)"
        },
        "rho_ice": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_mantle": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 3300.0,
          "description": "mantle density (bed_deformation.mantle_density)"
        },
        "dt_beddef": {
          "type": "parameter",
          "units": "s",
          "default": 3153600000.0,
          "description": "update interval length (100 '365day years')"
        },
        "bed_out_1": {
          "type": "unknown",
          "units": "m",
          "description": "bed elevation after update 1: bed_in_1 - f*(load_avg_1 - load_last_0) (= -f*150 m under the ice)"
        },
        "load_last_1": {
          "type": "unknown",
          "units": "m",
          "description": "load_last after update 1: load_last <- load_avg_1"
        },
        "uplift_1": {
          "type": "unknown",
          "units": "m/s",
          "description": "bedrock uplift rate over interval 1: (bed_out_1 - bed_in_1)/dt_beddef"
        },
        "bed_out_2": {
          "type": "unknown",
          "units": "m",
          "description": "bed elevation after update 2: bed_out_1 - f*(load_avg_2 - load_last_1) (= -f*300 m under the ice)"
        },
        "load_last_2": {
          "type": "unknown",
          "units": "m",
          "description": "load_last after update 2: load_last <- load_avg_2"
        },
        "uplift_2": {
          "type": "unknown",
          "units": "m/s",
          "description": "bedrock uplift rate over interval 2: (bed_out_2 - bed_out_1)/dt_beddef"
        }
      },
      "equations": [
        {
          "_comment": "Update 1 (PointwiseIsostasy::update_impl consuming the time-averaged load of interval 1): bed_out_1 = bed_in_1 - f*(load_avg_1 - load_last_0).",
          "lhs": "bed_out_1",
          "rhs": {
            "op": "isostatic_bed_update",
            "args": [
              "bed_in_1",
              "load_avg_1",
              "load_last_0",
              "rho_ice",
              "rho_mantle"
            ]
          }
        },
        {
          "_comment": "Update 1: load_last <- load_avg_1.",
          "lhs": "load_last_1",
          "rhs": "load_avg_1"
        },
        {
          "_comment": "BedDef::update after update_impl: uplift_1 = (topg - topg_last)/dt_beddef, topg_last <- topg (the C++ computes uplift = (topg - topg_last)*(1/dt_beddef)).",
          "lhs": "uplift_1",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "-",
                "args": [
                  "bed_out_1",
                  "bed_in_1"
                ]
              },
              "dt_beddef"
            ]
          }
        },
        {
          "_comment": "Update 2 (the load of interval 2 is compared against load_last_1 = load_avg_1, and the bed against bed_out_1): bed_out_2 = bed_out_1 - f*(load_avg_2 - load_last_1).",
          "lhs": "bed_out_2",
          "rhs": {
            "op": "isostatic_bed_update",
            "args": [
              "bed_out_1",
              "load_avg_2",
              "load_last_1",
              "rho_ice",
              "rho_mantle"
            ]
          }
        },
        {
          "_comment": "Update 2: load_last <- load_avg_2.",
          "lhs": "load_last_2",
          "rhs": "load_avg_2"
        },
        {
          "_comment": "BedDef::update after update_impl: uplift_2 = (topg - topg_last)/dt_beddef over interval 2.",
          "lhs": "uplift_2",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "-",
                "args": [
                  "bed_out_2",
                  "bed_out_1"
                ]
              },
              "dt_beddef"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "two_intervals_15_15",
          "description": "Two full update intervals of bed::PointwiseIsostasy at dome cell (15,15) (the dome, H0 = 2999.9999752362119 m): load_last starts at the initial load H0 = 2999.9999752362119 m (init_impl), update 1 consumes load_avg_1 = 3149.9999752362119 m and update 2 load_avg_2 = 3299.9999752362119 m, each with uplift = (bed_out - bed_in)/dt_beddef, dt_beddef = 100 '365day years' (stage1/dumps/bed/columns.csv). bed_out_1 = -f*150 m, bed_out_2 = -f*300 m (a load change is fully compensated in the single update that follows it).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "load_last_0": 2999.999975236212,
            "load_avg_1": 3149.999975236212,
            "load_avg_2": 3299.999975236212,
            "bed_in_1": 0.0
          },
          "assertions": [
            {
              "variable": "bed_out_1",
              "time": 0.0,
              "expected": -41.36363636363637,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "uplift_1",
              "time": 0.0,
              "expected": -1.3116323047829898e-08,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "bed_out_2",
              "time": 0.0,
              "expected": -82.72727272727273,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "uplift_2",
              "time": 0.0,
              "expected": -1.3116323047829898e-08,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "load_last_1",
              "time": 0.0,
              "expected": 3149.999975236212,
              "tolerance": {
                "rel": 1e-12
              }
            },
            {
              "variable": "load_last_2",
              "time": 0.0,
              "expected": 3299.999975236212,
              "tolerance": {
                "rel": 1e-12
              }
            }
          ]
        },
        {
          "id": "two_intervals_14_15",
          "description": "Two full update intervals of bed::PointwiseIsostasy at near-dome cell (14,15) (a cell whose accumulator round-off makes the dumped bed differ from -f*150 in the 15th digit): load_last starts at the initial load H0 = 2945.7933387368698 m (init_impl), update 1 consumes load_avg_1 = 3095.7933387368703 m and update 2 load_avg_2 = 3245.7933387368703 m, each with uplift = (bed_out - bed_in)/dt_beddef, dt_beddef = 100 '365day years' (stage1/dumps/bed/columns.csv). bed_out_1 = -f*150 m, bed_out_2 = -f*300 m (a load change is fully compensated in the single update that follows it).",
