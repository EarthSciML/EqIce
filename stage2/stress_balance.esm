            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "ifelse",
              "args": [
                { "op": "==", "args": ["sb_model", 1] },
                { "op": "index", "args": ["vbar_col", "i"] },
                { "op": "index", "args": ["v3_sia", "i"] }
              ]
            }
          }
        },
        {
          "_comment": "u_x = D_x*(west*(u3 - u3_w) + east*(u3_e - u3)) at each level (the C++ u_x of compute_vertical_velocity / compute_volumetric_strain_heating).",
          "lhs": "u_x",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "sb_derivative_x",
              "args": [
                "west",
                "east",
                "dx",
                { "op": "index", "args": ["u3", "i"] },
                { "op": "index", "args": ["u3_w", "i"] },
                { "op": "index", "args": ["u3_e", "i"] }
              ]
            }
          }
        },
        {
          "_comment": "v_y = D_y*(south*(v3 - v3_s) + north*(v3_n - v3)) at each level.",
          "lhs": "v_y",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "sb_derivative_y",
              "args": [
                "south",
                "north",
                "dy",
                { "op": "index", "args": ["v3", "i"] },
                { "op": "index", "args": ["v3_s", "i"] },
                { "op": "index", "args": ["v3_n", "i"] }
              ]
            }
          }
        },
        {
          "_comment": "u_y = D_y*(south*(u3 - u3_s) + north*(u3_n - u3)) at each level (the strain-heating cross derivative).",
          "lhs": "u_y",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "sb_derivative_y",
              "args": [
                "south",
                "north",
                "dy",
                { "op": "index", "args": ["u3", "i"] },
                { "op": "index", "args": ["u3_s", "i"] },
                { "op": "index", "args": ["u3_n", "i"] }
              ]
            }
          }
        },
        {
          "_comment": "v_x = D_x*(west*(v3 - v3_w) + east*(v3_e - v3)) at each level (the strain-heating cross derivative).",
          "lhs": "v_x",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "sb_derivative_x",
              "args": [
                "west",
                "east",
                "dx",
                { "op": "index", "args": ["v3", "i"] },
                { "op": "index", "args": ["v3_w", "i"] },
                { "op": "index", "args": ["v3_e", "i"] }
              ]
            }
          }
        },
        {
          "_comment": "u_z: centered (u3[i+1]-u3[i-1])/(z[i+1]-z[i-1]) in the interior, the C++ one-sided bed difference (u3[2]-u3[1])/(z[2]-z[1]) at i = 1 (StressBalance::compute_volumetric_strain_heating: dz = z[k+1]-z[k-1] for k > 0, dz = z[1]-z[0] at k = 0); computed for k <= ks only (the faq filter; the C++ k-loop reads u[ks+1] with ks <= Mz-2 for H < Lz, so the [1,60] ranges keep every index in bounds). The bed/interior switch is a makearray region split because the native compiler's index analysis admits only affine index maps (u3[i+1], u3[i-1]) or constant selects (u3[1], u3[2]).",
          "lhs": "u_z",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [[1, 1]],
              [[2, 60]]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": ["i"],
                "ranges": { "i": [1, 1] },
                "filter": { "op": "<=", "args": ["i", { "op": "+", "args": ["ks", 1] }] },
                "expr": {
                  "op": "/",
                  "args": [
                    { "op": "-", "args": [
                      { "op": "index", "args": ["u3", 2] },
                      { "op": "index", "args": ["u3", 1] } ] },
                    { "op": "-", "args": [
                      { "op": "index", "args": ["z", 2] },
                      { "op": "index", "args": ["z", 1] } ] }
                  ]
                }
              },
              {
                "op": "faq",
                "args": [],
                "output_idx": ["i"],
                "ranges": { "i": [2, 60] },
                "filter": { "op": "<=", "args": ["i", { "op": "+", "args": ["ks", 1] }] },
                "expr": {
                  "op": "/",
                  "args": [
                    { "op": "-", "args": [
                      { "op": "index", "args": ["u3", { "op": "+", "args": ["i", 1] }] },
                      { "op": "index", "args": ["u3", { "op": "-", "args": ["i", 1] }] } ] },
                    { "op": "-", "args": [
                      { "op": "index", "args": ["z", { "op": "+", "args": ["i", 1] }] },
                      { "op": "index", "args": ["z", { "op": "-", "args": ["i", 1] }] } ] }
                  ]
                }
              }
            ]
          }
        },
        {
          "_comment": "v_z: the v3 analogue of u_z (the same makearray bed/interior region split).",
          "lhs": "v_z",
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [[1, 1]],
              [[2, 60]]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": ["i"],
                "ranges": { "i": [1, 1] },
                "filter": { "op": "<=", "args": ["i", { "op": "+", "args": ["ks", 1] }] },
                "expr": {
                  "op": "/",
                  "args": [
                    { "op": "-", "args": [
                      { "op": "index", "args": ["v3", 2] },
                      { "op": "index", "args": ["v3", 1] } ] },
                    { "op": "-", "args": [
                      { "op": "index", "args": ["z", 2] },
                      { "op": "index", "args": ["z", 1] } ] }
                  ]
                }
              },
              {
                "op": "faq",
                "args": [],
                "output_idx": ["i"],
                "ranges": { "i": [2, 60] },
                "filter": { "op": "<=", "args": ["i", { "op": "+", "args": ["ks", 1] }] },
                "expr": {
                  "op": "/",
                  "args": [
                    { "op": "-", "args": [
                      { "op": "index", "args": ["v3", { "op": "+", "args": ["i", 1] }] },
                      { "op": "index", "args": ["v3", { "op": "-", "args": ["i", 1] }] } ] },
                    { "op": "-", "args": [
                      { "op": "index", "args": ["z", { "op": "+", "args": ["i", 1] }] },
                      { "op": "index", "args": ["z", { "op": "-", "args": ["i", 1] }] } ] }
                  ]
                }
              }
            ]
          }
        },
        {
          "_comment": "Horizontal divergence u_x + v_y at each level (the C++ u_x_plus_v_y of compute_vertical_velocity).",
          "lhs": "div",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "+",
              "args": [
                { "op": "index", "args": ["u_x", "i"] },
                { "op": "index", "args": ["v_y", "i"] }
              ]
            }
          }
        },
        {
          "_comment": "Hydrostatic ice pressure rho_ice*g*max(H - z, 0) at each level (EnthalpyConverter::pressure, the strain-heating hardness argument).",
          "lhs": "pressure",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "*",
              "args": [
                "rho_ice",
                "g",
                { "op": "max", "args": [{ "op": "-", "args": ["H", { "op": "index", "args": ["z", "i"] }] }, 0.0] }
              ]
            }
          }
        },
        {
          "_comment": "Volumetric strain heating sigma[k] = 2*e^(-1/n)*B[k]*D2[k]^(0.5*(1/n+1)) for k <= ks, 0 above (the filter leaves the out-of-filter levels at 0, matching the C++ zeroing of the levels above ks; StressBalance::compute_volumetric_strain_heating).",
          "lhs": "sigma",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "filter": { "op": "<=", "args": ["i", { "op": "+", "args": ["ks", 1] }] },
            "expr": {
              "op": "sb_strain_heating",
              "args": [
                "e_factor",
                {
                  "op": "sb_hardness_arr",
                  "args": [
                    { "op": "index", "args": ["E", "i"] },
                    { "op": "index", "args": ["pressure", "i"] }
                  ]
                },
                {
                  "op": "sb_D2",
                  "args": [
                    { "op": "index", "args": ["u_x", "i"] },
                    { "op": "index", "args": ["u_y", "i"] },
                    { "op": "index", "args": ["u_z", "i"] },
                    { "op": "index", "args": ["v_x", "i"] },
                    { "op": "index", "args": ["v_y", "i"] },
                    { "op": "index", "args": ["v_z", "i"] }
                  ]
                },
                "n"
              ]
            }
          }
        },
        {
          "_comment": "Basal frictional heating F_b = ifelse(mask_c in {3,4}, 0, C*(ubar^2 + vbar^2)) with the purely-plastic drag C (ShallowStressBalance::compute_basal_frictional_heating; mask.ocean = floating or ice-free ocean).",
          "lhs": "F_b",
          "rhs": {
            "op": "sb_basal_frictional_heating",
            "args": ["mask_c", "tauc", "eps", "ubar", "vbar"]
          }
        },
        {
          "_comment": "Vertical velocity from incompressibility: computed by the mounted SIAVerticalVelocity from the assembled div and coupled back in as w3_sia.",
          "lhs": "w3",
          "rhs": "w3_sia"
        },
        {
          "_comment": "SIA diffusive flux pass-throughs (the assembled interface outputs).",
          "lhs": "q_x",
          "rhs": "q_x_sia"
        },
        {
          "lhs": "q_y",
          "rhs": "q_y_sia"
        }
