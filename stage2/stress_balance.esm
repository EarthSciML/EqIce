  "coupling": [
    {
      "type": "variable_map",
      "from": "SIAEast.I",
      "to": "SIAVel.I_e",
      "transform": "param_to_var",
      "description": "I(z) column at the east staggered point (i,j,0) into the SIA velocity stencil."
    },
    {
      "type": "variable_map",
      "from": "SIAWest.I",
      "to": "SIAVel.I_w",
      "transform": "param_to_var",
      "description": "I(z) column at the west staggered point (i-1,j,0) into the SIA velocity stencil."
    },
    {
      "type": "variable_map",
      "from": "SIANorth.I",
      "to": "SIAVel.I_n",
      "transform": "param_to_var",
      "description": "I(z) column at the north staggered point (i,j,1) into the SIA velocity stencil."
    },
    {
      "type": "variable_map",
      "from": "SIASouth.I",
      "to": "SIAVel.I_s",
      "transform": "param_to_var",
      "description": "I(z) column at the south staggered point (i,j-1,1) into the SIA velocity stencil."
    },
    {
      "type": "variable_map",
      "from": "SIAEast.D",
      "to": "SIAFlux.D",
      "transform": "param_to_var",
      "description": "SIA diffusivity at the east staggered point into the diffusive-flux component."
    },
    {
      "type": "variable_map",
      "from": "StressBalance.ubar",
      "to": "SIAVel.sliding_velocity_u",
      "transform": "param_to_var",
      "description": "Assembled 2D velocity x-component as the SIA basal sliding velocity (ZeroSliding gives 0, SSA gives u_ssa)."
    },
    {
      "type": "variable_map",
      "from": "StressBalance.vbar",
      "to": "SIAVel.sliding_velocity_v",
      "transform": "param_to_var",
      "description": "Assembled 2D velocity y-component as the SIA basal sliding velocity."
    },
    {
      "type": "variable_map",
      "from": "SIAVel.u3",
      "to": "StressBalance.u3_sia",
      "transform": "param_to_var",
      "description": "SIA 3D velocity x-component (with sliding) into the assembler."
    },
    {
      "type": "variable_map",
      "from": "SIAVel.v3",
      "to": "StressBalance.v3_sia",
      "transform": "param_to_var",
      "description": "SIA 3D velocity y-component (with sliding) into the assembler."
    },
    {
      "type": "variable_map",
      "from": "StressBalance.div",
      "to": "SIAW.div",
      "transform": "param_to_var",
      "description": "Assembled horizontal divergence into the vertical-velocity component."
    },
    {
      "type": "variable_map",
      "from": "SIAW.w3",
      "to": "StressBalance.w3_sia",
      "transform": "param_to_var",
      "description": "Vertical velocity of the SIA part (trapezoid of -div) back into the assembler."
    },
    {
      "type": "variable_map",
      "from": "SIAFlux.q_x",
      "to": "StressBalance.q_x_sia",
      "transform": "param_to_var",
      "description": "SIA diffusive flux x-component at the east staggered point into the assembler."
    },
    {
      "type": "variable_map",
      "from": "SIAFlux.q_y",
      "to": "StressBalance.q_y_sia",
      "transform": "param_to_var",
      "description": "SIA diffusive flux y-component at the east staggered point into the assembler."
    },
    {
      "type": "variable_map",
      "from": "SSA.u",
      "to": "StressBalance.u_ssa",
      "transform": {
        "op": "index",
        "args": ["SSA.u", 30]
      },
      "description": "SSA velocity at the sampled cell: esm index 30 of the 60-cell flow line = dump cell 29 of stage1/dumps/ssa/columns.csv."
    }
  ]
