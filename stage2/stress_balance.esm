        {
          "_comment": "3D velocity selection: model = ssa gives the constant-in-column velocity (ConstantInColumn); models sia/ssa+sia give the SIA profile with sliding.",
          "lhs": "u3",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "ifelse",
              "args": [
                { "op": "==", "args": ["sb_model", 1] },
                { "op": "index", "args": ["ubar_col", "i"] },
                { "op": "index", "args": ["u3_sia", "i"] }
              ]
            }
          }
        },
