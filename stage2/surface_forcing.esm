    {
      "id": "yearly_cycle_flat_center",
      "description": "Yearly-cycle temperature time series at the near-dome sample point (i,j)=(15,15): lat=-70 deg, usurf=1490.5051884649215 m (the dome cell); for the martin parameterization T_ms = T_ma, so T_cycle = T_ma + (T_ms - T_ma)*cos(2 pi (year_frac - summerday_frac)) is flat at every sampled year_frac (the dump samples ts = {0..1 yr}/12) and precipitation is time-independent (stage1/dumps/surface_ocean/atmosphere_temperature_timeseries.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"usurf_m":1490.5051884649215,"lat_deg":-70.0,"r_m":1.0,"Lx_m":900000.0,"year_frac":0.0},
      "assertions": [
        { "variable": "T_cycle", "time": 0.0, "expected": 243.82871108651307, "tolerance": { "rel": 1e-12 } },
        { "variable": "precipitation", "time": 0.0, "expected": 9.506629392226242e-06, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "yearly_cycle_flat_north",
      "description": "Yearly-cycle temperature time series at the north-edge sample point (i,j)=(15,30): lat=-60.322580645161288 deg, usurf=0; flat for martin (stage1/dumps/surface_ocean/atmosphere_temperature_timeseries.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"usurf_m":0.0,"lat_deg":-60.32258064516129,"r_m":870967.7419354839,"Lx_m":900000.0,"year_frac":0.0},
      "assertions": [
        { "variable": "T_cycle", "time": 0.0, "expected": 261.6631451612903, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "yearly_cycle_flat_south",
      "description": "Yearly-cycle temperature time series at the south-edge sample point (i,j)=(15,0): lat=-79.677419354838705 deg, usurf=0; flat for martin (stage1/dumps/surface_ocean/atmosphere_temperature_timeseries.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"usurf_m":0.0,"lat_deg":-79.6774193548387,"r_m":870967.7419354839,"Lx_m":900000.0,"year_frac":0.0},
      "assertions": [
        { "variable": "T_cycle", "time": 0.0, "expected": 248.35185483870967, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "yearly_cycle_flat_midyear",
      "description": "Flatness at the quarter-year point: with T_ms = T_ma the cosine term vanishes for ANY year_frac and summerday_frac, so T_cycle = T_ma at year_frac = 0.25 too (the martin yearly cycle has zero amplitude; general YearlyCycle formula is T_ma + (T_ms - T_ma) cos(2 pi (year_frac - summerday_frac))).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"usurf_m":1490.5051884649215,"lat_deg":-70.0,"r_m":1.0,"Lx_m":900000.0,"year_frac":0.25},
      "assertions": [
        { "variable": "T_cycle", "time": 0.0, "expected": 243.82871108651307, "tolerance": { "rel": 1e-12 } }
      ]
    }
      ]
    },
    "SurfacePIK": {
      "expression_template_imports": [
        {
          "ref": "./surface_forcing_templates.esm"
        }
      ],
      "variables": {
        "smb": {
          "type": "parameter",
          "units": "kg/m^2/s",
          "default": 9.1343127559633896e-06,
          "description": "surface mass balance (surface::PIK m_mass_flux; held constant from a file in real runs; the driver prescribes it as precipitation minus the ablation blob; the dome cell value)"
        },
        "usurf_m": {
          "type": "parameter",
          "units": "m",
          "default": 1490.5051884649215,
          "description": "ice surface elevation (geometry.ice_surface_elevation); the dome cell value"
        },
        "lat_deg": {
          "type": "parameter",
          "units": "degrees",
          "default": -70.0,
          "description": "latitude in degrees north (geometry.latitude); the dome cell value"
        },
        "accumulation": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface accumulation = max(smb, 0) (SurfaceModel::dummy_accumulation)"
        },
        "melt": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface melt = max(-smb, 0) (SurfaceModel::dummy_melt; all melt runs off)"
        },
        "runoff": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface runoff = max(-smb, 0) (SurfaceModel::dummy_runoff)"
        },
        "mass_flux": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface mass balance output = accumulation - runoff = smb (surface::PIK mass_flux(); the dummy_* partition guarantees the identity)"
        },
        "temperature": {
          "type": "unknown",
          "units": "K",
          "description": "ice surface temperature, Martin et al. (2011) eq. (1) -- identical to the PIK atmosphere air_temperature field-for-field (surface::PIK::update_impl)"
        }
      },
      "equations": [
        {
          "_comment": "SurfaceModel::dummy_accumulation: accumulation = max(smb, 0).",
          "lhs": "accumulation",
          "rhs": {
            "op": "smb_accumulation",
            "args": ["smb"]
          }
        },
        {
          "_comment": "SurfaceModel::dummy_melt: melt = max(-smb, 0).",
          "lhs": "melt",
          "rhs": {
            "op": "smb_melt_runoff",
            "args": ["smb"]
          }
        },
        {
          "_comment": "SurfaceModel::dummy_runoff: runoff = max(-smb, 0).",
          "lhs": "runoff",
          "rhs": {
            "op": "smb_melt_runoff",
            "args": ["smb"]
          }
        },
        {
          "_comment": "SMB identity: mass_flux = accumulation - runoff (always equals smb under the dummy partition).",
          "lhs": "mass_flux",
          "rhs": {
            "op": "surface_mass_flux_identity",
            "args": ["accumulation", "runoff"]
          }
        },
        {
          "_comment": "surface::PIK::update_impl ice surface temperature: 273.15 + 30 - 0.0075*usurf - 0.68775*lat*(-1), the same Martin 2011 formula as the PIK atmosphere.",
          "lhs": "temperature",
          "rhs": {
            "op": "martin_mean_annual_temperature",
            "args": ["usurf_m", "lat_deg"]
          }
        }
      ],
      "tests": [
    {
      "id": "partition_smb_m5p0000000000000002em05",
      "description": "surface::PIK SMB partition at smb=-5.0000000000000002e-05 kg m^-2 s^-1 (SurfaceModel::dummy_*): accumulation = max(smb,0), melt = runoff = max(-smb,0), and mass_flux = accumulation - runoff = smb (stage1/dumps/surface_ocean/surface_partition.csv).",
      "time_span": { "start": 0.0, "end": 1.0 },
      "parameter_overrides": {"smb":-5e-05},
      "assertions": [
        { "variable": "accumulation", "time": 0.0, "expected": 0.0, "tolerance": { "rel": 1e-12 } },
        { "variable": "melt", "time": 0.0, "expected": 5e-05, "tolerance": { "rel": 1e-12 } },
        { "variable": "runoff", "time": 0.0, "expected": 5e-05, "tolerance": { "rel": 1e-12 } },
        { "variable": "mass_flux", "time": 0.0, "expected": -5e-05, "tolerance": { "rel": 1e-12 } }
      ]
    },
    {
      "id": "partition_smb_m3p0000000000000001em05",
