    "SurfaceOceanCoupler": {
      "expression_template_imports": [
        {
          "ref": "./surface_forcing_templates.esm"
        }
      ],
      "variables": {
        "x_m": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "x-coordinate of the cell center (grid x(i))"
        },
        "y_m": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "y-coordinate of the cell center (grid y(j))"
        },
        "r_m": {
          "type": "parameter",
          "units": "m",
          "default": 1.0,
          "description": "radial distance from the dome center (grid::radius)"
        },
        "lat_deg": {
          "type": "parameter",
          "units": "degrees",
          "default": -70.0,
          "description": "latitude in degrees north (geometry.latitude)"
        },
        "H_m": {
          "type": "parameter",
          "units": "m",
          "default": 2999.9999752362119,
          "description": "ice thickness (geometry.ice_thickness)"
        },
        "usurf_m": {
          "type": "parameter",
          "units": "m",
          "default": 1490.5051884649215,
          "description": "ice surface elevation (geometry.ice_surface_elevation)"
        },
        "bed_m": {
          "type": "parameter",
          "units": "m",
          "default": -1509.4947867712904,
          "description": "bed elevation (geometry.bed_elevation)"
        },
        "z_s_m": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "sea level elevation (geometry.sea_level_elevation)"
        },
        "Lx_m": {
          "type": "parameter",
          "units": "m",
          "default": 900000.0,
          "description": "domain half-width (grid.Lx)"
        },
        "Ly_m": {
          "type": "parameter",
          "units": "m",
          "default": 900000.0,
          "description": "domain half-height (grid.Ly)"
        },
        "sigma_m": {
          "type": "parameter",
          "units": "m",
          "default": 250000.0,
          "description": "width of the driver's ablation blob (sigma = 250 km)"
        },
        "precip_scale": {
          "type": "parameter",
          "units": "kg/m^2/s",
          "default": 3.1688764640818492e-06,
          "description": "100 kg m^-2 yr^-1 converted to kg m^-2 s^-1 (1 year = 3.15569259747e7 s)"
        },
        "abl_peak": {
          "type": "parameter",
          "units": "kg/m^2/s",
          "default": 9.5066293922455477e-06,
          "description": "peak of the driver's ablation blob: 300 kg m^-2 yr^-1 converted to kg m^-2 s^-1"
        },
        "melt_rate_m_per_s": {
          "type": "parameter",
          "units": "m/s",
          "default": 1.6450966622180257e-09,
          "description": "constant-ocean melt rate ocean.constant.melt_rate = 0.051914193590840291 m/yr converted to m/s"
        },
        "T_ocean_K": {
          "type": "parameter",
          "units": "K",
          "default": 271.45,
          "description": "ocean temperature T_ocean = -1.7 deg C (hard-coded default in ConstantPIK.cc)"
        },
        "T0": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "fresh-water melting point (constants.fresh_water.melting_point_temperature)"
        },
        "beta_CC": {
          "type": "parameter",
          "units": "K/Pa",
          "default": 7.9e-08,
          "description": "Clausius-Clapeyron gradient (constants.ice.beta_Clausius_Clapeyron)"
        },
        "rho_i": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 910.0,
          "description": "ice density (constants.ice.density)"
        },
        "rho_w": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1028.0,
          "description": "sea water density (constants.sea_water.density)"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "standard gravity (constants.standard_gravity)"
        },
        "salinity": {
          "type": "parameter",
          "units": "g/kg",
          "default": 35.0,
          "description": "ocean salinity, g/kg (hard-coded in ConstantPIK.cc)"
        },
        "melt_factor": {
          "type": "parameter",
          "units": "1",
          "default": 0.005,
          "description": "ocean.pik_melt_factor"
        },
        "c_p_ocean": {
          "type": "parameter",
          "units": "J/(kg K)",
          "default": 3974.0,
          "description": "specific heat capacity of the ocean mixed layer (hard-coded 3974 J/(K kg) in ConstantPIK.cc)"
        },
        "gamma_T": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0001,
          "description": "thermal exchange velocity (hard-coded 1e-4 m/s in ConstantPIK.cc)"
        },
        "L": {
          "type": "parameter",
          "units": "J/kg",
          "default": 334000.0,
          "description": "latent heat of fusion of fresh water (constants.fresh_water.latent_heat_of_fusion)"
        },
        "T_ma": {
          "type": "unknown",
          "units": "K",
          "description": "mean annual near-surface air temperature (atmosphere PIK, martin)"
        },
        "T_ms": {
          "type": "unknown",
          "units": "K",
          "description": "mean summer near-surface air temperature (martin: equal to T_ma)"
        },
        "precipitation": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "atmosphere PIK precipitation (driver-prescribed, time-independent)"
        },
        "smb": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface mass balance = precipitation - ablation blob (the driver wiring of surface::PIK's constant SMB field)"
        },
        "surface_accumulation": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface accumulation = max(smb, 0)"
        },
        "surface_melt": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface melt = max(-smb, 0)"
        },
        "surface_runoff": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface runoff = max(-smb, 0)"
        },
        "surface_mass_flux": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "surface mass balance output = accumulation - runoff"
        },
        "surface_temperature": {
          "type": "unknown",
          "units": "K",
          "description": "ice surface temperature (surface PIK; the Martin 2011 formula, equal to the atmosphere air temperature)"
        },
        "shelf_base_temperature": {
          "type": "unknown",
          "units": "K",
          "description": "shelf base temperature T0 - beta_CC*rho_i*g*H (PIK and Constant oceans)"
        },
        "shelf_base_elevation": {
          "type": "unknown",
          "units": "m",
          "description": "shelf base elevation z_b = -(rho_i/rho_w) H"
        },
        "freezing_temperature": {
          "type": "unknown",
          "units": "K",
          "description": "ocean freezing temperature T_f = 273.15 + 0.0939 - 0.057*S + 7.64e-4*z_b (Beckmann & Goosse 2003)"
        },
        "ocean_heat_flux": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "ocean-to-ice heat flux Q = melt_factor*rho_w*c_p_ocean*gamma_T*(T_ocean - T_f)"
        },
        "shelf_base_mass_flux": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "shelf base mass flux = Q/L (positive = melting)"
        },
        "ice_bottom": {
          "type": "unknown",
          "units": "m",
          "description": "ice bottom elevation max(bed, z_s - rho_i/rho_w H)"
        },
        "water_column_height": {
          "type": "unknown",
          "units": "m",
          "description": "water column height max(z_s - ice_bottom, 0)"
        },
        "average_water_column_pressure": {
          "type": "unknown",
          "units": "Pa",
          "description": "depth-averaged water column pressure 0.5 rho_w g h_w^2 / H (PIK and Constant oceans)"
        },
        "shelfbtemp_const": {
          "type": "unknown",
          "units": "K",
          "description": "Constant-ocean shelf base temperature (same pressure melting point as PIK)"
        },
        "shelfbmassflux_const": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "Constant-ocean shelf base mass flux = melt_rate * rho_i (uniform over the domain)"
        },
        "awcp_const": {
          "type": "unknown",
          "units": "Pa",
          "description": "Constant-ocean average water column pressure (identical to PIK)"
        }
      },
      "equations": [
        {
          "_comment": "Coupling: atmosphere PIK T_ma (martin), passed field-for-field to the surface temperature.",
          "lhs": "T_ma",
          "rhs": { "op": "martin_mean_annual_temperature", "args": ["usurf_m", "lat_deg"] }
        },
        {
          "_comment": "Coupling: martin T_ms = T_ma.",
          "lhs": "T_ms",
          "rhs": "T_ma"
        },
        {
          "_comment": "Coupling: the driver fills atmosphere::PIK's precipitation field.",
          "lhs": "precipitation",
          "rhs": { "op": "prescribed_precipitation", "args": ["r_m", "Lx_m"] }
        },
        {
          "_comment": "Coupling: the driver fills surface::PIK's SMB field as precipitation minus the ablation blob (instrument_surface_ocean.cc).",
          "lhs": "smb",
          "rhs": { "op": "-", "args": [
            "precipitation",
            { "op": "surface_ablation_blob", "args": ["x_m", "y_m", "Ly_m", "sigma_m"] }
          ] }
        },
        {
          "_comment": "Surface partition: accumulation = max(smb, 0).",
          "lhs": "surface_accumulation",
          "rhs": { "op": "smb_accumulation", "args": ["smb"] }
        },
        {
          "_comment": "Surface partition: melt = max(-smb, 0).",
          "lhs": "surface_melt",
          "rhs": { "op": "smb_melt_runoff", "args": ["smb"] }
        },
        {
          "_comment": "Surface partition: runoff = max(-smb, 0).",
          "lhs": "surface_runoff",
          "rhs": { "op": "smb_melt_runoff", "args": ["smb"] }
        },
        {
          "_comment": "SMB identity: mass_flux = accumulation - runoff.",
          "lhs": "surface_mass_flux",
          "rhs": { "op": "surface_mass_flux_identity", "args": ["surface_accumulation", "surface_runoff"] }
        },
        {
          "_comment": "Surface temperature = the atmosphere T_ma (both the Martin 2011 formula).",
          "lhs": "surface_temperature",
          "rhs": { "op": "martin_mean_annual_temperature", "args": ["usurf_m", "lat_deg"] }
        },
        {
          "_comment": "Ocean PIK: shelf base temperature (pressure melting point).",
          "lhs": "shelf_base_temperature",
          "rhs": { "op": "shelf_base_temperature", "args": ["H_m"] }
        },
        {
          "_comment": "Ocean PIK mass flux chain: z_b.",
          "lhs": "shelf_base_elevation",
          "rhs": { "op": "shelf_base_elevation", "args": ["H_m"] }
        },
        {
          "_comment": "Ocean PIK mass flux chain: T_f.",
          "lhs": "freezing_temperature",
          "rhs": { "op": "beckmann_goosse_freezing_temperature", "args": ["shelf_base_elevation"] }
        },
        {
          "_comment": "Ocean PIK mass flux chain: Q.",
          "lhs": "ocean_heat_flux",
          "rhs": { "op": "ocean_to_ice_heat_flux", "args": ["T_ocean_K", "freezing_temperature"] }
        },
        {
          "_comment": "Ocean PIK mass flux chain: mass_flux = Q/L.",
          "lhs": "shelf_base_mass_flux",
          "rhs": { "op": "shelf_base_mass_flux", "args": ["ocean_heat_flux"] }
        },
        {
          "_comment": "Ocean PIK water column pressure chain: ice_bottom.",
          "lhs": "ice_bottom",
          "rhs": { "op": "ice_bottom_elevation", "args": ["H_m", "bed_m", "z_s_m"] }
        },
        {
          "_comment": "Ocean PIK water column pressure chain: h_w.",
          "lhs": "water_column_height",
          "rhs": { "op": "water_column_height", "args": ["z_s_m", "ice_bottom"] }
        },
        {
          "_comment": "Ocean PIK water column pressure: P = 0.5 rho_w g h_w^2 / H.",
          "lhs": "average_water_column_pressure",
          "rhs": { "op": "average_water_column_pressure", "args": ["H_m", "water_column_height"] }
        },
        {
          "_comment": "Constant ocean cross-check: shelf base temperature identical to the PIK pressure melting point.",
          "lhs": "shelfbtemp_const",
          "rhs": { "op": "shelf_base_temperature", "args": ["H_m"] }
        },
        {
          "_comment": "Constant ocean cross-check: uniform mass flux = melt_rate * rho_i (ocean.constant.melt_rate = 0.051914 m/yr).",
          "lhs": "shelfbmassflux_const",
          "rhs": { "op": "constant_ocean_mass_flux", "args": ["melt_rate_m_per_s"] }
        },
        {
          "_comment": "Constant ocean cross-check: average water column pressure identical to the PIK value.",
          "lhs": "awcp_const",
          "rhs": { "op": "average_water_column_pressure", "args": ["H_m", "water_column_height"] }
        }
      ],
      "tests": [
