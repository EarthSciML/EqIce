        {
          "_comment": "w3 from incompressibility: cumulative trapezoid of -div (StressBalance::compute_vertical_velocity)",
          "lhs": "w3",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "reduce": "+",
            "ranges": {
              "i": { "from": "lev" },
              "j": [1, 60]
            },
            "filter": { "op": "<", "args": ["j", "i"] },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "trapezoid_step",
                  "args": [
                    { "op": "index", "args": ["z", "j"] },
                    { "op": "index", "args": ["z", { "op": "+", "args": ["j", 1] }] },
                    { "op": "index", "args": ["div", "j"] },
                    { "op": "index", "args": ["div", { "op": "+", "args": ["j", 1] }] }
                  ]
                }
              ]
            }
          }
        }
      ],
