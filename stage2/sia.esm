      "equations": [
        {
          "_comment": "u3[k] = sliding_u - 0.25*(I_e*h_x_e + I_w*h_x_w + I_n*h_x_n + I_s*h_x_s) (SIAFD::compute_3d_horizontal_velocity)",
          "lhs": "u3",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "-",
              "args": [
                "sliding_velocity_u",
                {
                  "op": "*",
                  "args": [
                    0.25,
                    {
                      "op": "+",
                      "args": [
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_e", "i"] }, "h_x_e" ] },
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_w", "i"] }, "h_x_w" ] },
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_n", "i"] }, "h_x_n" ] },
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_s", "i"] }, "h_x_s" ] }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "v3[k] = sliding_v - 0.25*(I_e*h_y_e + I_w*h_y_w + I_n*h_y_n + I_s*h_y_s) (SIAFD::compute_3d_horizontal_velocity)",
          "lhs": "v3",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "lev" } },
            "expr": {
              "op": "-",
              "args": [
                "sliding_velocity_v",
                {
                  "op": "*",
                  "args": [
                    0.25,
                    {
                      "op": "+",
                      "args": [
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_e", "i"] }, "h_y_e" ] },
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_w", "i"] }, "h_y_w" ] },
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_n", "i"] }, "h_y_n" ] },
                        { "op": "*", "args": [
                          { "op": "index", "args": ["I_s", "i"] }, "h_y_s" ] }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "velocity_cell_20_16",
          "description": "3D horizontal velocity at cell center (20,16) from the four staggered-neighbor I(z) columns and surface gradients (stage1/dumps/sia/columns.csv and delta.csv).",
          "time_span": { "start": 0.0, "end": 1.0 },
          "assertions": [
            {
              "variable": "u3", "time": 0.0, "coords": { "lev": 1 },
              "expected": 0.0, "tolerance": { "rel": 1e-12 }
            },
            {
