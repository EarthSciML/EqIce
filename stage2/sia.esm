              "expected": 7.7720526036116862e-08, "tolerance": { "rel": 1e-12 }
            },
            {
              "variable": "u3", "time": 0.0, "coords": { "lev": 36 },
              "expected": 7.810174517397102e-08, "tolerance": { "rel": 1e-12 }
            },
            {
              "variable": "v3", "time": 0.0, "coords": { "lev": 1 },
              "expected": 0.0, "tolerance": { "rel": 1e-12 }
            },
            {
              "variable": "v3", "time": 0.0, "coords": { "lev": 2 },
              "expected": 3.1334406813115367e-09, "tolerance": { "rel": 1e-12 }
            },
            {
              "variable": "v3", "time": 0.0, "coords": { "lev": 11 },
              "expected": 1.4160038352926708e-08, "tolerance": { "rel": 1e-12 }
            },
            {
